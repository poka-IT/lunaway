  "query": "\n        SELECT e.epoch,\n               d.oid::int8 AS \"database!\",\n               (SELECT coalesce(max(updated_seq), 0) FROM places) AS \"last_seq!\"\n        FROM sync_epoch e, pg_database d\n        WHERE d.datname = current_database()\n        ",
