  "query": "\n        SELECT place_id, status,\n               EXISTS (SELECT 1 FROM content_reports c\n                       WHERE c.target_id = reviews.id AND c.dismissed_at IS NULL) AS \"reported!\"\n        FROM reviews WHERE id = $1 AND account_id = $2 FOR UPDATE\n        ",
