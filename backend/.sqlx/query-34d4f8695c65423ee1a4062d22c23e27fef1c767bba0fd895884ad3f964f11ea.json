  "query": "\n        SELECT reporter AS \"reporter!\", kind AS \"kind!\", value_m, created_at AS \"created_at!\",\n            trusted AS \"trusted!\"\n        FROM road_event_report_facts\n        WHERE event_id = $1 AND status = 'active' AND (kind = $2 OR kind = 'cleared')\n          AND NOT banned\n        ORDER BY created_at\n        ",
