  "query": "\n        SELECT r.id, r.source_id, r.poi_id, r.account_id, a.pseudonym AS \"author?\", r.stars,\n               r.body, r.lang, r.visited_on, r.status, r.created_at, r.updated_at\n        FROM poi_reviews r LEFT JOIN accounts a ON a.id = r.account_id\n        WHERE r.id = $1\n        ",
