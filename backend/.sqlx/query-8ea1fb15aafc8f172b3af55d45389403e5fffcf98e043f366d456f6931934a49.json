  "query": "\n        SELECT r.id, r.place_id, r.account_id, a.pseudonym AS \"author?\", r.stars, r.body, r.lang,\n               r.visited_on, r.vehicle, r.status, r.created_at, r.updated_at\n        FROM reviews r LEFT JOIN accounts a ON a.id = r.account_id\n        WHERE r.id = $1\n        ",
