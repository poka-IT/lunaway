  "query": "\n        SELECT r.id, r.event_id AS \"event_id!\", e.confidence,\n            coalesce(e.ended_at, e.valid_to, e.last_seen_at) AS \"until!\"\n        FROM road_event_reports r JOIN road_events e ON e.id = r.event_id\n        WHERE r.id = $1 AND r.account_id = $2\n        ",
