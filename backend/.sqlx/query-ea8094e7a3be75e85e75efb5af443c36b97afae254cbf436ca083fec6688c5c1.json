{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT e.place_id, e.seq FROM place_region_exits e\n        WHERE e.region = $1 AND e.seq > $2 AND e.seq <= $3\n          AND NOT EXISTS (SELECT 1 FROM places p WHERE p.id = e.place_id AND p.region = e.region)\n        ORDER BY e.seq\n        LIMIT $4\n        ",
