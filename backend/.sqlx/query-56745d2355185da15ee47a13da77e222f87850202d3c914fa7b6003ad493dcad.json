{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT p.id AS \"poi_id!\", m.code AS \"code!\", m.name AS \"name!\"\n        FROM pois p\n        CROSS JOIN LATERAL (\n            SELECT code, name FROM municipalities m\n            WHERE ST_Covers(m.geom, p.geom::geometry)\n            ORDER BY code\n            LIMIT 1\n        ) m\n        WHERE p.id = ANY($1)\n        ",
