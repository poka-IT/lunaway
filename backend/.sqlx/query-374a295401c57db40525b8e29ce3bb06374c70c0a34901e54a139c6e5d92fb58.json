  "query": "\n        SELECT a.id, a.pseudonym, a.banned_at IS NOT NULL AS \"banned!\"\n        FROM merged_keys m JOIN accounts a ON a.id = m.into_account\n        WHERE m.key_hash = sha256($1)\n        ",
