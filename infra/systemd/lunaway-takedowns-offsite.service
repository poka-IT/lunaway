# Encrypts the takedown journal into the off-site copy
# (/usr/local/sbin/lunaway-takedowns-offsite). Runs as root without
# capabilities, so file permissions bind it like any user: it reads the
# journal as a member of lunaway-takedowns (/srv/data/place-takedowns,
# lunaway-ingest:lunaway-takedowns 2750, files 0640), the age recipient (root
# 0600), writes only its own /srv/data/backups/offsite/place-takedowns
# (root:lunaway-pull 2750) and the days of the last copy in its state
# directory on the root disk, which outlives a lost data volume.
# Installed by infra/server/backups.sh.
[Unit]
Description=Lunaway takedown journal, encrypted off-site copy
RequiresMountsFor=/srv/data

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/lunaway-takedowns-offsite
TimeoutStartSec=10min
Nice=10
IOSchedulingClass=idle
UMask=0027

# lunaway-takedowns reads the journal. lunaway-pull opens the way to the
# copy: root without capabilities is "other" on /srv/data/backups/offsite
# (postgres:lunaway-pull, 2750), as for the account deletions' copy.
SupplementaryGroups=lunaway-takedowns lunaway-pull
StateDirectory=lunaway-takedowns-offsite
StateDirectoryMode=0700

ProtectSystem=strict
ReadWritePaths=/srv/data/backups/offsite/place-takedowns
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateIPC=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
MemoryMax=256M
