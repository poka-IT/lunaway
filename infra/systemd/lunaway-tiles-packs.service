# Builds the offline basemap packs from the basemap build being served and
# switches their manifest (/usr/local/sbin/lunaway-tiles-packs). Started by
# lunaway-tiles-refresh.service when a refresh succeeds, and daily by
# lunaway-tiles-packs.timer, which finds nothing to build when the manifest
# already names the served build, and removes the previous set a week after
# the switch. Installed by infra/server/tiles.sh.
[Unit]
Description=Lunaway basemap: build the offline packs
After=lunaway-tiles-refresh.service
RequiresMountsFor=/srv/data
ConditionPathExists=/usr/local/bin/pmtiles

[Service]
Type=oneshot
User=lunaway-tiles
Group=lunaway-tiles
UMask=0022
Environment=LUNAWAY_PACKS_MAXZOOM=14
ExecStart=/usr/local/sbin/lunaway-tiles-packs
# The 39 packs of 2026-10-06 took 215 s to build; a cold page cache, a
# slow volume or many more regions stay well inside this.
TimeoutStartSec=2h
# Behind the API and PostgreSQL for CPU and disk.
Nice=10
CPUWeight=20
IOSchedulingClass=idle

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateIPC=yes
KeyringMode=private
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
# Reads the basemap build, writes the packs, their manifest and its work
# files (packs/.work, one mount with the packs so publishing is a rename).
# Of /srv it sees those two directories only: the data volume also holds
# the dumps, the photos and the import cache.
TemporaryFileSystem=/srv:ro
BindReadOnlyPaths=/srv/basemap
BindPaths=/srv/data/basemap/packs
# Reads local files only: no network at all.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SocketBindDeny=any
# pmtiles extract holds about three quarters of the largest pack in memory
# (Germany at zoom 14: 1995 MiB resident, 2026-10-06).
MemoryHigh=2560M
MemoryMax=3G
