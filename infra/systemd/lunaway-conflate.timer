# Every night just after midnight in France, so the opening hours the API
# serves start from the new day (the CLI takes "today" in Europe/Paris),
# whether or not an import ran.
[Unit]
Description=Lunaway conflation, nightly

[Timer]
OnCalendar=*-*-* 00:05 Europe/Paris
RandomizedDelaySec=2m
Persistent=true

[Install]
WantedBy=timers.target
