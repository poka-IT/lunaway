# Every three minutes: the DIR publishes about 110 increments an hour
# (2 645 in 24 hours on 2026-10-06), so a run reads about five. A missed run
# is not caught up: the next one resumes from the stored cursor. The status
# page alerts when the DIR feed has not been read for 15 minutes.
[Unit]
Description=Lunaway road events, every three minutes

[Timer]
OnCalendar=*:0/3
RandomizedDelaySec=20s
AccuracySec=10s

[Install]
WantedBy=timers.target
