# The 28th of each month at 09:00 UTC: Overture publishes a release in the
# second half of each month (2026-08-19, 2026-09-23), and the points of
# interest of the day have run (the European groups at 05:45, two hours at
# most), which the service waits for when one still runs (After=).
[Unit]
Description=Lunaway import: Overture Maps Places, monthly

[Timer]
OnCalendar=*-*-28 09:00
RandomizedDelaySec=5m
Persistent=true

[Install]
WantedBy=timers.target
