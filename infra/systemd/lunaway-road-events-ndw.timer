# Every three hours, though NDW writes the file every 15 minutes: a Dutch
# event reaches the routes and the phones up to about three hours after
# NDW publishes it.
[Unit]
Description=Lunaway road events: NDW (Netherlands), every three hours

[Timer]
OnCalendar=*-*-* 00/3:40:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
