# The Lunaway API behind Caddy. Installed by infra/server/api.sh; the binary
# under /opt/lunaway/current is switched by infra/deploy-api.sh.
[Unit]
Description=Lunaway API (GraphQL over HTTP)
Documentation=https://github.com/poka-IT/lunaway/blob/main/docs/deploy.md
After=network-online.target postgresql.service
Wants=network-online.target
# Photos and the account deletion journal are written to the data volume.
RequiresMountsFor=/srv/data
StartLimitIntervalSec=60
StartLimitBurst=5
# Before the first deploy there is no binary: skip the unit instead of
# failing it into its start limit.
ConditionPathExists=/opt/lunaway/current/lunaway-api

[Service]
Type=exec
ExecStart=/opt/lunaway/current/lunaway-api
# DATABASE_URL and other secrets, root-owned 0600, read by systemd before the
# process drops to its user. media.env: LUNAWAY_MEDIA_DIR,
# LUNAWAY_MEDIA_BASE_URL, LUNAWAY_PUBLIC_URL and LUNAWAY_DELETION_JOURNAL,
# rendered by infra/server/api.sh.
EnvironmentFile=/etc/lunaway/api.env
EnvironmentFile=/etc/lunaway/media.env
Environment=LUNAWAY_LISTEN=127.0.0.1:8484
# The geocoders of the map's search, through Caddy on the loopback
# (infra/caddy/geocoders.caddy): the API reaches nothing off the host.
Environment=LUNAWAY_GEOCODE_BAN_URL=http://127.0.0.1:8486/ban
Environment="LUNAWAY_GEOCODE_PHOTON_URL=http://127.0.0.1:8486/photon/europe http://127.0.0.1:8486/photon/morocco"
Environment=RUST_LOG=info
# Plain text in the journal, without terminal colour codes.
Environment=NO_COLOR=1
Restart=on-failure
RestartSec=2s
TimeoutStopSec=20s

# Identity: a static system user, because the photos it writes outlive any
# run of the service. It owns /srv/data/media and /srv/data/account-deletions
# and nothing else; the photos it writes are world-readable (UMask 0022) so
# Caddy can serve them, the journal's files are created 0640 by the API
# itself and readable by group lunaway-deletions only (the directory is
# setgid), for their encrypted copy (lunaway-deletions-offsite).
User=lunaway-api
Group=lunaway-api
UMask=0022

# Filesystem: the whole tree read-only, no home, private /tmp and /dev. Of
# /srv it sees only the photos and the deletion journal, and may write there
# only. The API refuses to start when it cannot write the journal.
ProtectSystem=strict
ProtectHome=yes
TemporaryFileSystem=/srv:ro
BindPaths=/srv/data/media /srv/data/account-deletions
ReadWritePaths=/srv/data/media /srv/data/account-deletions
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectProc=invisible
ProcSubset=pid

# Kernel and host: nothing to tune, load, log, or rename.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateIPC=yes
KeyringMode=private

# Privileges: none, and no way to gain any.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

# Network: loopback only. Caddy reaches the API on 127.0.0.1:8484 and the API
# reaches PostgreSQL on 127.0.0.1:5432 and the geocoders through Caddy on
# 127.0.0.1:8486; the API calls nothing outside the host. Widen
# IPAddressAllow the day it has to.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
SocketBindDeny=any
SocketBindAllow=tcp:8484

# Resources: a runaway process is stopped before it starves PostgreSQL. Two
# photo decodes at once (LUNAWAY_MEDIA_WORKERS) take up to 256 MB each plus
# their copies: about 1 GB at the peak (report of backend iteration 2).
MemoryHigh=1280M
MemoryMax=1536M
TasksMax=512
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
