# Merges the changed records into places, and slides the opening-hours
# window to today. Started after each successful import (OnSuccess= of the
# import units), so an import lands even while the worker
# (lunaway-conflate-worker.service) is down; the two wait for each other on
# the writers' lock. Installed by infra/server/pipeline.sh.
[Unit]
Description=Lunaway conflation
After=postgresql.service
Requires=postgresql.service
ConditionPathExists=/opt/lunaway/current/lunaway
# The regional first-sync packs follow the places: a region whose places
# changed gets a new pack (lunaway-packs.service, also daily at 06:30).
OnSuccess=lunaway-packs.service

[Service]
Type=oneshot
User=lunaway-ingest
Group=lunaway-ingest
UMask=0077
EnvironmentFile=/etc/lunaway/ingest.env
# LUNAWAY_TAKEDOWN_SECRET: the keyed cells around each place taken down,
# where a new or moving place waits for a moderator (generated by
# infra/server/pipeline.sh). The journal is only named: the conflation
# reads the cells from the database and writes no takedown.
EnvironmentFile=/etc/lunaway/takedown.env
Environment=LUNAWAY_TAKEDOWN_JOURNAL=/srv/data/place-takedowns
Environment=LUNAWAY_DATA_DIR=/srv/data/ingest
Environment=RUST_LOG=info
# Plain text in the journal, without terminal colour codes.
Environment=NO_COLOR=1
ExecStart=/opt/lunaway/current/lunaway conflate
TimeoutStartSec=1h
Nice=10

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateIPC=yes
KeyringMode=private
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
# PostgreSQL on loopback, nothing else.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
SocketBindDeny=any
MemoryHigh=1536M
MemoryMax=2G
