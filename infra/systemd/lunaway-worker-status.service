# Measures the conflation worker's queues for the health probe
# (/usr/local/sbin/lunaway-worker-status). Runs as postgres, which reads them
# through the local socket; writes one file under /var/lib/lunaway-status,
# world-readable, holding counts and ages only. Installed by
# infra/server/pipeline.sh.
[Unit]
Description=Lunaway conflation worker, queue measure
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
StateDirectory=lunaway-status
StateDirectoryMode=0755
UMask=0022
ExecStart=/usr/local/sbin/lunaway-worker-status
TimeoutStartSec=1min
# Every minute: keep the journal to failures. What the script prints goes
# in at warning, above the filter; systemd's start and stop lines do not.
SyslogLevel=warning
LogLevelMax=notice

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateIPC=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
# The PostgreSQL socket only.
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
MemoryMax=128M
