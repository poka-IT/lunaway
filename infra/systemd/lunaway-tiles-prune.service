# Removes the basemap builds not served once the one served has served a
# day (/usr/local/sbin/lunaway-tiles-refresh --prune): the previous build
# stays for the clients that read the TileJSON before the switch (cached an
# hour), then gives its 36 GB back to the root disk, which the database, the
# routing graphs and Photon share. Run by lunaway-tiles-prune.timer;
# installed by infra/server/tiles.sh.
[Unit]
Description=Lunaway basemap: remove the builds no longer served
ConditionPathExists=/usr/local/bin/pmtiles

[Service]
Type=oneshot
User=lunaway-tiles
Group=lunaway-tiles
UMask=0022
ExecStart=/usr/local/sbin/lunaway-tiles-refresh --prune
TimeoutStartSec=10min
Nice=10

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateIPC=yes
KeyringMode=private
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
ReadWritePaths=/srv/basemap/builds /srv/basemap/serve
InaccessiblePaths=-/srv/data -/var/lib/postgresql
# Local files only.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SocketBindDeny=any
MemoryMax=256M
