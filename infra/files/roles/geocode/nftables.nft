# Geocode role: the ports of Photon (2322 Europe, 2323 Morocco) and of the
# translation server (2324), to the backend's API (through its Caddy) and
# nothing else, on the private interface only. Appended to the input chain
# of the base ruleset (/etc/nftables.conf), installed as
# /etc/nftables.d/lunaway-role.nft. The
# status page checks Photon through the API, as a user meets it, and the
# translation server through the backend's probe; the refreshes only make
# outbound connections, which the output chain accepts.
# The addresses are LUNAWAY_BACKEND_PRIVATE_IP and
# LUNAWAY_GEOCODE_PRIVATE_IP of infra/lib.sh.
table inet lunaway {
	chain input {
		iifname "enp7s0" ip saddr 10.42.0.2 ip daddr 10.42.0.4 tcp dport { 2322, 2323, 2324 } accept
	}
}
