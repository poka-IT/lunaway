# Ops role: the web ports of the status page, appended to the input chain of
# the base ruleset (/etc/nftables.conf), with the same per-source limits as
# the backend's. Installed as /etc/nftables.d/lunaway-role.nft. Gatus and the
# dump replica only make outbound connections, which the output chain accepts.
table inet lunaway {
	# Per-source limits on the web ports, coarse on purpose: one HTTP/2 or
	# HTTP/3 connection carries many requests, and a mobile carrier's NAT puts
	# many users behind one IPv4 address. They stop connection floods; request
	# rates are the API's job. IPv6 sources are counted per /64, the block a
	# single subscriber gets.
	set web_rate_v4 {
		type ipv4_addr
		flags dynamic, timeout
		timeout 2m
	}
	set web_rate_v6 {
		type ipv6_addr
		flags dynamic, timeout
		timeout 2m
	}
	set web_conn_v4 {
		type ipv4_addr
		flags dynamic
	}
	set web_conn_v6 {
		type ipv6_addr
		flags dynamic
	}

	chain input {
		meta l4proto { tcp, udp } th dport { 80, 443 } ct state new add @web_rate_v4 { ip saddr limit rate over 300/minute burst 300 packets } drop
		meta l4proto { tcp, udp } th dport { 80, 443 } ct state new add @web_rate_v6 { ip6 saddr & ffff:ffff:ffff:ffff:: limit rate over 300/minute burst 300 packets } drop
		tcp dport { 80, 443 } ct state new add @web_conn_v4 { ip saddr ct count over 256 } drop
		tcp dport { 80, 443 } ct state new add @web_conn_v6 { ip6 saddr & ffff:ffff:ffff:ffff:: ct count over 256 } drop
		tcp dport { 80, 443 } accept
		udp dport 443 accept
	}
}
