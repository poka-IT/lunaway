#!/bin/sh
# Health facts of the backend as one JSON object, computed at each call. The
# forced command of the ops server's probe key (infra/server/ops-access.sh):
# Gatus on the ops server runs it over SSH every few minutes and checks the
# fields. Runs as lunaway-pull, reads nothing secret, writes nothing, and
# ignores the command the client asked for.
#
#   postgresql         "ok" when the cluster accepts connections on loopback
#   data_volume        whether /srv/data is mounted, and how full it is
#   root_disk          how full / is
#   dump.ok            true when the last nightly dump succeeded less than
#                      26 hours ago and no failure was recorded after it
#   tiles              whether the tile volume is mounted, how full it is
#                      (two planets and two sets of offline packs fill it to
#                      about 90% after a refresh, by design), how full it
#                      would be without the planet builds not served
#                      (held_percent: the refresh removes those to make room,
#                      lunaway-tiles-refresh), the planet build served and
#                      its age in days
#   packs.ok           true when the offline packs' manifest names as many
#                      packs as there are outlines, its build is less than 35
#                      days old, and it is the planet build served (or the
#                      planet switched less than a day ago: the packs follow
#                      within minutes, lunaway-tiles-packs)
#   worker.ok          true when lunaway-conflate-worker is active, its queues
#                      were measured less than 5 minutes ago
#                      (lunaway-worker-status, every minute) and nothing has
#                      waited there for 15 minutes
#   media_backup.ok    true when the encrypted copy of the photos was brought
#                      up to date less than 26 hours ago
#   deletions_backup.ok  true when the encrypted copy of the account deletion
#                      journal was written less than 3 hours ago
#                      (lunaway-deletions-offsite, hourly): a restore
#                      replays it, or deleted accounts come back
#   takedowns_backup.ok  true when the encrypted copy of the takedown journal
#                      was written less than 3 hours ago
#                      (lunaway-takedowns-offsite, hourly): a restore replays
#                      it, or places taken down come back
#   fuel.ok            true when the fuel price feed was stored less than 2
#                      hours ago (lunaway-ingest-fuel, every 15 minutes), as
#                      measured by lunaway-worker-status in the last 5 minutes
#   routing.ok         true when valhalla.service is active and the graph it
#                      serves (/srv/routing/current) was built less than 10
#                      days ago: built weekly, installed by a daily refresh
#   imports.ok         true when the OpenStreetMap places of France were read
#                      less than 30 hours ago (daily) and every other country
#                      less than 8 days ago (weekly groups), as measured by
#                      lunaway-worker-status in the last 30 minutes, and no
#                      unit of the places and points imports, the regional
#                      packs or the speed cameras is failed (a truncation
#                      guard refusing a country fails its import)
#   region_packs.ok    true when no sync region has waited more than two days
#                      for a pack with its changes (lunaway-packs, after each
#                      import and daily), and at least one pack exists
#   poi_layer.ok       true when no change of the points layer has waited
#                      more than 8 hours for its publication (every 6 hours)
#   cameras.ok         true when the five official speed camera lists were
#                      all read less than 30 hours ago (daily)
#   enforcement.ok     true when the zones and points were built less than 30
#                      hours ago (lunaway-enforcement, daily)
#   extcom.ok          true when neither the import of the external community
#                      feed (lunaway-ingest-extcom: a checksum that does not
#                      match, a refused or failed import, a feed dated in the
#                      future) nor the purge of its retired photos
#                      (lunaway-extcom-purge-media, which completes an
#                      erasure) is failed. A failed import keeps failing at
#                      each hourly try until a person looks or a newer feed
#                      imports; both units are absent where the feed is off
set -u
offsite=/srv/data/backups/offsite

percent() { df --output=pcent "$1" 2>/dev/null | tail -n 1 | tr -dc '0-9'; }
# A UTC stamp of the dump script (20261006T001502Z) as seconds since 1970.
stamp_seconds() {
	date -u -d "$(echo "$1" | sed -E 's/^([0-9]{4})([0-9]{2})([0-9]{2})T([0-9]{2})([0-9]{2})([0-9]{2})Z$/\1-\2-\3 \4:\5:\6/')" +%s 2>/dev/null
}
read_stamp() {
	[ -r "$1" ] || return 0
	head -c 32 "$1" | grep -E '^[0-9]{8}T[0-9]{6}Z$' || true
}

if pg_isready -q -h 127.0.0.1 -p 5432 -t 5; then postgresql=ok; else postgresql=down; fi
if mountpoint -q /srv/data; then mounted=true; else mounted=false; fi
data_used="$(percent /srv/data)"
root_used="$(percent /)"

last_success="$(read_stamp "$offsite/last-success")"
last_failure="$(read_stamp "$offsite/last-failure")"
dump_ok=false
age_hours=-1
success_at=""
failure_at=0
[ -n "$last_success" ] && success_at="$(stamp_seconds "$last_success")"
[ -n "$last_failure" ] && failure_at="$(stamp_seconds "$last_failure")"
if [ -n "$success_at" ]; then
	age_hours=$(( ($(date -u +%s) - success_at) / 3600 ))
	if [ "$age_hours" -lt 26 ] && [ "${failure_at:-0}" -lt "$success_at" ]; then
		dump_ok=true
	fi
fi

if mountpoint -q /srv/tiles; then tiles_mounted=true; else tiles_mounted=false; fi
tiles_used="$(percent /srv/tiles)"
# What the volume holds once the planet builds not served are counted as
# free: the next refresh removes them first, so this is the room it has.
tiles_spare=0
served_planet="$(readlink /srv/tiles/serve/planet.pmtiles 2>/dev/null | sed -nE 's|^\.\./builds/([0-9]{8}\.pmtiles)$|\1|p')"
for f in /srv/tiles/builds/*.pmtiles; do
	[ -f "$f" ] || continue
	[ "$(basename "$f")" = "$served_planet" ] && continue
	tiles_spare=$((tiles_spare + $(stat -c %s "$f")))
done
tiles_size="$(df --output=size -B1 /srv/tiles 2>/dev/null | tail -n 1 | tr -dc '0-9')"
tiles_usedb="$(df --output=used -B1 /srv/tiles 2>/dev/null | tail -n 1 | tr -dc '0-9')"
tiles_held=100
if [ -n "$tiles_size" ] && [ "$tiles_size" -gt 0 ] && [ -n "$tiles_usedb" ]; then
	tiles_held=$(( (tiles_usedb - tiles_spare) * 100 / tiles_size ))
fi
# The build behind the stable alias, named by the date of its OpenStreetMap data.
tiles_build="$(readlink /srv/tiles/serve/planet.pmtiles 2>/dev/null | sed -nE 's|^\.\./builds/([0-9]{8})\.pmtiles$|\1|p')"
tiles_age=-1
if [ -n "$tiles_build" ]; then
	tiles_age=$(( ($(date -u +%s) - $(date -u -d "$tiles_build" +%s)) / 86400 ))
fi

# The offline packs (docs/deploy.md, "Offline packs"): the manifest's own
# build, read from its head (the top-level key comes first), its number of
# packs against the number of outlines installed.
packs_manifest=/srv/tiles/packs/manifest.json
packs_build="$(head -c 2048 "$packs_manifest" 2>/dev/null | sed -nE 's/^ *"build": *"([0-9]{8})",?$/\1/p' | head -n 1)"
packs_count="$(grep -c '"sha256":' "$packs_manifest" 2>/dev/null || true)"
packs_expected="$(grep -o '"kind":' /usr/local/share/lunaway/pack-regions.geojson 2>/dev/null | wc -l)"
packs_age=-1
if [ -n "$packs_build" ]; then
	packs_age=$(( ($(date -u +%s) - $(date -u -d "$packs_build" +%s)) / 86400 ))
fi
planet_switched_s=$(( $(date -u +%s) - $(stat -c %Y /srv/tiles/serve/planet.pmtiles 2>/dev/null || echo 0) ))
packs_ok=false
if [ "$packs_age" -ge 0 ] && [ "$packs_age" -lt 35 ] && [ "${packs_count:-0}" -gt 0 ] && [ "${packs_count:-0}" -eq "$packs_expected" ] \
	&& { [ "$packs_build" = "$tiles_build" ] || [ "$planet_switched_s" -lt 86400 ]; }; then
	packs_ok=true
fi

# The conflation worker: its unit, and the queue measure written by postgres
# (counts and ages only; digits are all that is taken from it).
worker_state="$(systemctl show -p ActiveState --value lunaway-conflate-worker 2>/dev/null | tr -dc 'a-z')"
worker_restarts="$(systemctl show -p NRestarts --value lunaway-conflate-worker 2>/dev/null | tr -dc '0-9')"
worker_status=/var/lib/lunaway-status/worker.json
status_age=-1
queue_oldest=-1
flagged=-1
field() { sed -nE "s/.*\"$1\" *: *([0-9]+).*/\1/p" "$worker_status" | head -n 1; }
if [ -r "$worker_status" ]; then
	status_age=$(( $(date -u +%s) - $(stat -c %Y "$worker_status") ))
	refresh_oldest="$(field refresh_oldest_s)"
	submissions_oldest="$(field submissions_oldest_s)"
	flagged="$(field records_flagged)"
	queue_oldest="${refresh_oldest:-0}"
	[ "${submissions_oldest:-0}" -gt "$queue_oldest" ] && queue_oldest="$submissions_oldest"
	[ -n "$flagged" ] || flagged=-1
fi
worker_ok=false
if [ "$worker_state" = active ] && [ "$status_age" -ge 0 ] && [ "$status_age" -lt 300 ] && [ "$queue_oldest" -lt 900 ]; then
	worker_ok=true
fi

# The fuel prices (lunaway-ingest-fuel, every 15 minutes): their age comes
# from the same measure as the worker's queues.
fuel_age=-1
if [ -r "$worker_status" ]; then
	fuel_age="$(sed -nE 's/.*"fuel_age_s" *: *(-?[0-9]+).*/\1/p' "$worker_status" | head -n 1)"
	[ -n "$fuel_age" ] || fuel_age=-1
fi
fuel_ok=false
if [ "$status_age" -ge 0 ] && [ "$status_age" -lt 300 ] && [ "$fuel_age" -ge 0 ] && [ "$fuel_age" -lt 7200 ]; then
	fuel_ok=true
fi

# The measures of lunaway-worker-status that may be negative (-1: none).
signed() {
	v="$(sed -nE "s/.*\"$1\" *: *(-?[0-9]+).*/\1/p" "$2" 2>/dev/null | head -n 1)"
	echo "${v:--1}"
}
fresh_status=false
[ "$status_age" -ge 0 ] && [ "$status_age" -lt 300 ] && fresh_status=true

# The points layer's publication (lunaway-conflate-worker, every 6 hours).
layer_pending=-1
[ -r "$worker_status" ] && layer_pending="$(signed poi_layer_pending_s "$worker_status")"
layer_ok=false
[ "$fresh_status" = true ] && [ "$layer_pending" -lt 28800 ] && layer_ok=true

# The official speed camera lists (lunaway-cameras, daily): five of them.
camera_lists=0
camera_oldest=-1
if [ -r "$worker_status" ]; then
	camera_lists="$(signed camera_lists "$worker_status")"
	camera_oldest="$(signed camera_lists_oldest_s "$worker_status")"
fi
cameras_ok=false
[ "$fresh_status" = true ] && [ "$camera_lists" -ge 5 ] && [ "$camera_oldest" -ge 0 ] && [ "$camera_oldest" -lt 108000 ] && cameras_ok=true

# The zones and points (lunaway-enforcement, daily): the unit touches this
# file after each build that succeeds.
enforcement_age=-1
if [ -e /var/lib/lunaway-enforcement/built ]; then
	enforcement_age=$(( $(date -u +%s) - $(stat -c %Y /var/lib/lunaway-enforcement/built) ))
fi
enforcement_ok=false
[ "$enforcement_age" -ge 0 ] && [ "$enforcement_age" -lt 108000 ] && enforcement_ok=true

# The regional first-sync packs (lunaway-packs).
packs_regions=0
packs_built=0
packs_behind=0
packs_stale=-1
packs_newest=-1
if [ -r "$worker_status" ]; then
	packs_regions="$(signed regions "$worker_status")"
	packs_built="$(signed built "$worker_status")"
	packs_behind="$(signed behind "$worker_status")"
	packs_stale="$(signed stale "$worker_status")"
	packs_newest="$(signed newest_age_s "$worker_status")"
fi
region_packs_ok=false
[ "$fresh_status" = true ] && [ "$packs_stale" -eq 0 ] && [ "$packs_built" -gt 0 ] && region_packs_ok=true

# The OpenStreetMap imports: the age of each country's places, measured
# every 15 minutes (lunaway-worker-status), and the units that fail.
imports_status=/var/lib/lunaway-status/imports.json
imports_status_age=-1
fr_age=-1
oldest_age=-1
scopes=0
oldest_scope=""
if [ -r "$imports_status" ]; then
	imports_status_age=$(( $(date -u +%s) - $(stat -c %Y "$imports_status") ))
	fr_age="$(signed fr_age_s "$imports_status")"
	oldest_age="$(signed oldest_age_s "$imports_status")"
	scopes="$(signed scopes "$imports_status")"
	oldest_scope="$(sed -nE 's/.*"oldest_scope" *: *"([A-Z]{2})".*/\1/p' "$imports_status" | head -n 1)"
fi
failed_units="$(systemctl list-units --state=failed --no-legend --plain 'lunaway-ingest-osm*' 'lunaway-ingest-pois*' \
	'lunaway-packs*' 'lunaway-cameras*' 'lunaway-enforcement*' 2>/dev/null | awk '{ print $1 }' | grep -E '^[a-z@A-Z.-]+$' | tr '\n' ' ' | sed 's/ $//')"
failed_count="$(echo "$failed_units" | wc -w)"
imports_ok=false
if [ "$imports_status_age" -ge 0 ] && [ "$imports_status_age" -lt 1800 ] && [ "$fr_age" -ge 0 ] && [ "$fr_age" -lt 108000 ] \
	&& [ "$oldest_age" -ge 0 ] && [ "$oldest_age" -lt 691200 ] && [ "$failed_count" -eq 0 ]; then
	imports_ok=true
fi

# The external community feed: its import and the purge of its photos.
extcom_failed="$(systemctl list-units --state=failed --no-legend --plain 'lunaway-ingest-extcom*' \
	'lunaway-extcom-purge-media*' 2>/dev/null | awk '{ print $1 }' | grep -E '^[a-z@A-Z.-]+$' | tr '\n' ' ' | sed 's/ $//')"
extcom_failed_count="$(echo "$extcom_failed" | wc -w)"
extcom_ok=false
[ "$extcom_failed_count" -eq 0 ] && extcom_ok=true

# The encrypted copy of the photos (lunaway-media-offsite, nightly).
media_success="$(read_stamp "$offsite/media/last-success")"
media_ok=false
media_age=-1
if [ -n "$media_success" ]; then
	media_at="$(stamp_seconds "$media_success")"
	if [ -n "$media_at" ]; then
		media_age=$(( ($(date -u +%s) - media_at) / 3600 ))
		[ "$media_age" -lt 26 ] && media_ok=true
	fi
fi

# The encrypted copy of the account deletion journal (lunaway-deletions-offsite,
# hourly).
deletions_success="$(read_stamp "$offsite/account-deletions/last-success")"
deletions_ok=false
deletions_age=-1
if [ -n "$deletions_success" ]; then
	deletions_at="$(stamp_seconds "$deletions_success")"
	if [ -n "$deletions_at" ]; then
		deletions_age=$(( ($(date -u +%s) - deletions_at) / 3600 ))
		[ "$deletions_age" -lt 3 ] && deletions_ok=true
	fi
fi

# The encrypted copy of the takedown journal (lunaway-takedowns-offsite,
# hourly).
takedowns_success="$(read_stamp "$offsite/place-takedowns/last-success")"
takedowns_ok=false
takedowns_age=-1
if [ -n "$takedowns_success" ]; then
	takedowns_at="$(stamp_seconds "$takedowns_success")"
	if [ -n "$takedowns_at" ]; then
		takedowns_age=$(( ($(date -u +%s) - takedowns_at) / 3600 ))
		[ "$takedowns_age" -lt 3 ] && takedowns_ok=true
	fi
fi

# The routing engine (docs/deploy.md, "Routing"): its unit, the graph it
# serves and the build date read from that graph's build.json.
routing_state="$(systemctl show -p ActiveState --value valhalla 2>/dev/null | tr -dc 'a-z')"
routing_graph="$(readlink /srv/routing/current 2>/dev/null | sed -nE 's|^builds/([0-9]{8}T[0-9]{4}Z-[a-z0-9]{2,16})$|\1|p')"
routing_built="$(head -c 4096 /srv/routing/current/build.json 2>/dev/null | sed -nE 's/.*"built_at": *"([0-9]{4}-[0-9]{2}-[0-9]{2})T.*/\1/p' | head -n 1)"
routing_age=-1
if [ -n "$routing_built" ]; then
	routing_age=$(( ($(date -u +%s) - $(date -u -d "$routing_built" +%s)) / 86400 ))
fi
routing_ok=false
if [ "$routing_state" = active ] && [ -n "$routing_graph" ] && [ "$routing_age" -ge 0 ] && [ "$routing_age" -lt 10 ]; then
	routing_ok=true
fi

printf '{"postgresql":"%s","data_volume":{"mounted":%s,"used_percent":%s},"root_disk":{"used_percent":%s},"dump":{"ok":%s,"last_success":"%s","age_hours":%s,"last_failure":"%s"},"tiles":{"mounted":%s,"used_percent":%s,"held_percent":%s,"build":"%s","age_days":%s},"packs":{"ok":%s,"build":"%s","age_days":%s,"count":%s,"expected":%s},"worker":{"ok":%s,"state":"%s","restarts":%s,"status_age_s":%s,"queue_oldest_s":%s,"records_flagged":%s},"media_backup":{"ok":%s,"last_success":"%s","age_hours":%s},"deletions_backup":{"ok":%s,"last_success":"%s","age_hours":%s},"takedowns_backup":{"ok":%s,"last_success":"%s","age_hours":%s},"fuel":{"ok":%s,"age_s":%s},"routing":{"ok":%s,"state":"%s","graph":"%s","age_days":%s},"imports":{"ok":%s,"scopes":%s,"fr_age_s":%s,"oldest_scope":"%s","oldest_age_s":%s,"status_age_s":%s,"failed_units":%s,"failed":"%s"},"region_packs":{"ok":%s,"regions":%s,"built":%s,"behind":%s,"stale":%s,"newest_age_s":%s},"poi_layer":{"ok":%s,"pending_s":%s},"cameras":{"ok":%s,"lists":%s,"oldest_s":%s},"enforcement":{"ok":%s,"age_s":%s},"extcom":{"ok":%s,"failed_units":%s,"failed":"%s"}}\n' \
	"$postgresql" "$mounted" "${data_used:-100}" "${root_used:-100}" "$dump_ok" "$last_success" "$age_hours" "$last_failure" \
	"$tiles_mounted" "${tiles_used:-100}" "$tiles_held" "$tiles_build" "$tiles_age" \
	"$packs_ok" "$packs_build" "$packs_age" "${packs_count:-0}" "${packs_expected:-0}" \
	"$worker_ok" "${worker_state:-unknown}" "${worker_restarts:-0}" "$status_age" "$queue_oldest" "$flagged" \
	"$media_ok" "$media_success" "$media_age" \
	"$deletions_ok" "$deletions_success" "$deletions_age" \
	"$takedowns_ok" "$takedowns_success" "$takedowns_age" \
	"$fuel_ok" "$fuel_age" \
	"$routing_ok" "${routing_state:-unknown}" "$routing_graph" "$routing_age" \
	"$imports_ok" "$scopes" "$fr_age" "$oldest_scope" "$oldest_age" "$imports_status_age" "$failed_count" "$failed_units" \
	"$region_packs_ok" "$packs_regions" "$packs_built" "$packs_behind" "$packs_stale" "$packs_newest" \
	"$layer_ok" "$layer_pending" \
	"$cameras_ok" "$camera_lists" "$camera_oldest" \
	"$enforcement_ok" "$enforcement_age" \
	"$extcom_ok" "$extcom_failed_count" "$extcom_failed"
