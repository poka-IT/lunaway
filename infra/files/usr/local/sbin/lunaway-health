#!/bin/sh
# Health facts of the backend as one JSON object, computed at each call. The
# forced command of the ops server's probe key (infra/server/ops-access.sh):
# Gatus on the ops server runs it over SSH every few minutes and checks the
# fields. Runs as lunaway-pull, reads nothing secret, writes nothing, and
# ignores the command the client asked for.
#
#   postgresql         "ok" when the cluster accepts connections on loopback
#   data_volume        whether /srv/data is mounted, and how full it is
#   root_disk          how full / is
#   dump.ok            true when the last nightly dump succeeded less than
#                      26 hours ago and no failure was recorded after it
#   tiles              whether the tile volume is mounted, how full it is
#                      (two planets and two sets of offline packs fill it to
#                      about 90% after a refresh, by design), the planet build
#                      served and its age in days
#   packs.ok           true when the offline packs' manifest names as many
#                      packs as there are outlines, its build is less than 35
#                      days old, and it is the planet build served (or the
#                      planet switched less than a day ago: the packs follow
#                      within minutes, lunaway-tiles-packs)
#   worker.ok          true when lunaway-conflate-worker is active, its queues
#                      were measured less than 5 minutes ago
#                      (lunaway-worker-status, every minute) and nothing has
#                      waited there for 15 minutes
#   media_backup.ok    true when the encrypted copy of the photos was brought
#                      up to date less than 26 hours ago
#   deletions_backup.ok  true when the encrypted copy of the account deletion
#                      journal was written less than 3 hours ago
#                      (lunaway-deletions-offsite, hourly): a restore
#                      replays it, or deleted accounts come back
#   fuel.ok            true when the fuel price feed was stored less than 2
#                      hours ago (lunaway-ingest-fuel, every 15 minutes), as
#                      measured by lunaway-worker-status in the last 5 minutes
#   routing.ok         true when valhalla.service is active and the graph it
#                      serves (/srv/routing/current) was built less than 10
#                      days ago: built weekly, installed by a daily refresh
set -u
offsite=/srv/data/backups/offsite

percent() { df --output=pcent "$1" 2>/dev/null | tail -n 1 | tr -dc '0-9'; }
# A UTC stamp of the dump script (20261006T001502Z) as seconds since 1970.
stamp_seconds() {
	date -u -d "$(echo "$1" | sed -E 's/^([0-9]{4})([0-9]{2})([0-9]{2})T([0-9]{2})([0-9]{2})([0-9]{2})Z$/\1-\2-\3 \4:\5:\6/')" +%s 2>/dev/null
}
read_stamp() {
	[ -r "$1" ] || return 0
	head -c 32 "$1" | grep -E '^[0-9]{8}T[0-9]{6}Z$' || true
}

if pg_isready -q -h 127.0.0.1 -p 5432 -t 5; then postgresql=ok; else postgresql=down; fi
if mountpoint -q /srv/data; then mounted=true; else mounted=false; fi
data_used="$(percent /srv/data)"
root_used="$(percent /)"

last_success="$(read_stamp "$offsite/last-success")"
last_failure="$(read_stamp "$offsite/last-failure")"
dump_ok=false
age_hours=-1
success_at=""
failure_at=0
[ -n "$last_success" ] && success_at="$(stamp_seconds "$last_success")"
[ -n "$last_failure" ] && failure_at="$(stamp_seconds "$last_failure")"
if [ -n "$success_at" ]; then
	age_hours=$(( ($(date -u +%s) - success_at) / 3600 ))
	if [ "$age_hours" -lt 26 ] && [ "${failure_at:-0}" -lt "$success_at" ]; then
		dump_ok=true
	fi
fi

if mountpoint -q /srv/tiles; then tiles_mounted=true; else tiles_mounted=false; fi
tiles_used="$(percent /srv/tiles)"
# The build behind the stable alias, named by the date of its OpenStreetMap data.
tiles_build="$(readlink /srv/tiles/serve/planet.pmtiles 2>/dev/null | sed -nE 's|^\.\./builds/([0-9]{8})\.pmtiles$|\1|p')"
tiles_age=-1
if [ -n "$tiles_build" ]; then
	tiles_age=$(( ($(date -u +%s) - $(date -u -d "$tiles_build" +%s)) / 86400 ))
fi

# The offline packs (docs/deploy.md, "Offline packs"): the manifest's own
# build, read from its head (the top-level key comes first), its number of
# packs against the number of outlines installed.
packs_manifest=/srv/tiles/packs/manifest.json
packs_build="$(head -c 2048 "$packs_manifest" 2>/dev/null | sed -nE 's/^ *"build": *"([0-9]{8})",?$/\1/p' | head -n 1)"
packs_count="$(grep -c '"sha256":' "$packs_manifest" 2>/dev/null || true)"
packs_expected="$(grep -o '"kind":' /usr/local/share/lunaway/pack-regions.geojson 2>/dev/null | wc -l)"
packs_age=-1
if [ -n "$packs_build" ]; then
	packs_age=$(( ($(date -u +%s) - $(date -u -d "$packs_build" +%s)) / 86400 ))
fi
planet_switched_s=$(( $(date -u +%s) - $(stat -c %Y /srv/tiles/serve/planet.pmtiles 2>/dev/null || echo 0) ))
packs_ok=false
if [ "$packs_age" -ge 0 ] && [ "$packs_age" -lt 35 ] && [ "${packs_count:-0}" -gt 0 ] && [ "${packs_count:-0}" -eq "$packs_expected" ] \
	&& { [ "$packs_build" = "$tiles_build" ] || [ "$planet_switched_s" -lt 86400 ]; }; then
	packs_ok=true
fi

# The conflation worker: its unit, and the queue measure written by postgres
# (counts and ages only; digits are all that is taken from it).
worker_state="$(systemctl show -p ActiveState --value lunaway-conflate-worker 2>/dev/null | tr -dc 'a-z')"
worker_restarts="$(systemctl show -p NRestarts --value lunaway-conflate-worker 2>/dev/null | tr -dc '0-9')"
worker_status=/var/lib/lunaway-status/worker.json
status_age=-1
queue_oldest=-1
flagged=-1
field() { sed -nE "s/.*\"$1\" *: *([0-9]+).*/\1/p" "$worker_status" | head -n 1; }
if [ -r "$worker_status" ]; then
	status_age=$(( $(date -u +%s) - $(stat -c %Y "$worker_status") ))
	refresh_oldest="$(field refresh_oldest_s)"
	submissions_oldest="$(field submissions_oldest_s)"
	flagged="$(field records_flagged)"
	queue_oldest="${refresh_oldest:-0}"
	[ "${submissions_oldest:-0}" -gt "$queue_oldest" ] && queue_oldest="$submissions_oldest"
	[ -n "$flagged" ] || flagged=-1
fi
worker_ok=false
if [ "$worker_state" = active ] && [ "$status_age" -ge 0 ] && [ "$status_age" -lt 300 ] && [ "$queue_oldest" -lt 900 ]; then
	worker_ok=true
fi

# The fuel prices (lunaway-ingest-fuel, every 15 minutes): their age comes
# from the same measure as the worker's queues.
fuel_age=-1
if [ -r "$worker_status" ]; then
	fuel_age="$(sed -nE 's/.*"fuel_age_s" *: *(-?[0-9]+).*/\1/p' "$worker_status" | head -n 1)"
	[ -n "$fuel_age" ] || fuel_age=-1
fi
fuel_ok=false
if [ "$status_age" -ge 0 ] && [ "$status_age" -lt 300 ] && [ "$fuel_age" -ge 0 ] && [ "$fuel_age" -lt 7200 ]; then
	fuel_ok=true
fi

# The encrypted copy of the photos (lunaway-media-offsite, nightly).
media_success="$(read_stamp "$offsite/media/last-success")"
media_ok=false
media_age=-1
if [ -n "$media_success" ]; then
	media_at="$(stamp_seconds "$media_success")"
	if [ -n "$media_at" ]; then
		media_age=$(( ($(date -u +%s) - media_at) / 3600 ))
		[ "$media_age" -lt 26 ] && media_ok=true
	fi
fi

# The encrypted copy of the account deletion journal (lunaway-deletions-offsite,
# hourly).
deletions_success="$(read_stamp "$offsite/account-deletions/last-success")"
deletions_ok=false
deletions_age=-1
if [ -n "$deletions_success" ]; then
	deletions_at="$(stamp_seconds "$deletions_success")"
	if [ -n "$deletions_at" ]; then
		deletions_age=$(( ($(date -u +%s) - deletions_at) / 3600 ))
		[ "$deletions_age" -lt 3 ] && deletions_ok=true
	fi
fi

# The routing engine (docs/deploy.md, "Routing"): its unit, the graph it
# serves and the build date read from that graph's build.json.
routing_state="$(systemctl show -p ActiveState --value valhalla 2>/dev/null | tr -dc 'a-z')"
routing_graph="$(readlink /srv/routing/current 2>/dev/null | sed -nE 's|^builds/([0-9]{8}T[0-9]{4}Z-[a-z0-9]{2,16})$|\1|p')"
routing_built="$(head -c 4096 /srv/routing/current/build.json 2>/dev/null | sed -nE 's/.*"built_at": *"([0-9]{4}-[0-9]{2}-[0-9]{2})T.*/\1/p' | head -n 1)"
routing_age=-1
if [ -n "$routing_built" ]; then
	routing_age=$(( ($(date -u +%s) - $(date -u -d "$routing_built" +%s)) / 86400 ))
fi
routing_ok=false
if [ "$routing_state" = active ] && [ -n "$routing_graph" ] && [ "$routing_age" -ge 0 ] && [ "$routing_age" -lt 10 ]; then
	routing_ok=true
fi

printf '{"postgresql":"%s","data_volume":{"mounted":%s,"used_percent":%s},"root_disk":{"used_percent":%s},"dump":{"ok":%s,"last_success":"%s","age_hours":%s,"last_failure":"%s"},"tiles":{"mounted":%s,"used_percent":%s,"build":"%s","age_days":%s},"packs":{"ok":%s,"build":"%s","age_days":%s,"count":%s,"expected":%s},"worker":{"ok":%s,"state":"%s","restarts":%s,"status_age_s":%s,"queue_oldest_s":%s,"records_flagged":%s},"media_backup":{"ok":%s,"last_success":"%s","age_hours":%s},"deletions_backup":{"ok":%s,"last_success":"%s","age_hours":%s},"fuel":{"ok":%s,"age_s":%s},"routing":{"ok":%s,"state":"%s","graph":"%s","age_days":%s}}\n' \
	"$postgresql" "$mounted" "${data_used:-100}" "${root_used:-100}" "$dump_ok" "$last_success" "$age_hours" "$last_failure" \
	"$tiles_mounted" "${tiles_used:-100}" "$tiles_build" "$tiles_age" \
	"$packs_ok" "$packs_build" "$packs_age" "${packs_count:-0}" "${packs_expected:-0}" \
	"$worker_ok" "${worker_state:-unknown}" "${worker_restarts:-0}" "$status_age" "$queue_oldest" "$flagged" \
	"$media_ok" "$media_success" "$media_age" \
	"$deletions_ok" "$deletions_success" "$deletions_age" \
	"$fuel_ok" "$fuel_age" \
	"$routing_ok" "${routing_state:-unknown}" "$routing_graph" "$routing_age"
