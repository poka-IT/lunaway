#!/bin/sh
# Dumps the lunaway database and the cluster's roles, keeps the last
# LUNAWAY_DUMP_KEEP dumps on the data volume, writes an age-encrypted copy
# of each into the off-site directory, which the ops server pulls, and
# keeps the newest LUNAWAY_MIRROR_KEEP encrypted copies on the root disk.
#
# The root disk is what Hetzner's daily server backup captures (volumes are
# not part of it), so a lost volume still leaves a recent dump in the backup
# images; only encrypted ones, since those images are kept by Hetzner for a
# week outside the durations this project controls. The plaintext dumps
# stay on the data volume. The encrypted copies are encrypted to a
# recipient whose private key exists only on the maintainer's Mac: the ops
# server, the Mac and the images hold ciphertext they cannot read. A run that succeeds writes the time of its
# dump to last-success there; lunaway-pgdump-failed.service writes
# last-failure when one fails.
#
# Runs as postgres (peer authentication over the unix socket) from
# lunaway-pgdump.service, which passes the recipient as a credential.
#
#   lunaway-pgdump            a dump
#   lunaway-pgdump --failed   records a failed run (lunaway-pgdump-failed.service)
set -eu

primary=/srv/data/backups/postgresql
mirror=/var/backups/lunaway/postgresql
offsite=/srv/data/backups/offsite
if [ "${1:-}" = --failed ]; then
	umask 0027
	date -u +%Y%m%dT%H%M%SZ > "$offsite/last-failure.new"
	mv "$offsite/last-failure.new" "$offsite/last-failure"
	echo "recorded a failed dump in $offsite/last-failure"
	exit 0
fi
keep="${LUNAWAY_DUMP_KEEP:-7}"
mirror_keep="${LUNAWAY_MIRROR_KEEP:-3}"
# A count that is not a number would make every pruning test fail quietly,
# and the dumps would pile up: refuse it before dumping.
for n in "$keep" "$mirror_keep"; do
	case "$n" in
	'' | *[!0-9]* | 0)
		echo "error: LUNAWAY_DUMP_KEEP and LUNAWAY_MIRROR_KEEP must be positive integers" >&2
		exit 1
		;;
	esac
done
recipient_file="${CREDENTIALS_DIRECTORY:?run from lunaway-pgdump.service}/backup-recipient"
stamp=$(date -u +%Y%m%dT%H%M%SZ)

# A run stopped half-way (a failure, a timeout, a reboot) leaves no partial
# file behind: this run's on exit, an earlier run's right now.
cleanup() {
	rm -f "$primary/lunaway-$stamp.dump.partial" "$offsite/lunaway-$stamp.dump.age.partial" \
		"$offsite/globals-$stamp.sql.age.partial"
}
trap cleanup EXIT
trap 'exit 1' INT TERM
for f in "$primary"/*.partial "$offsite"/*.partial; do
	if [ -e "$f" ]; then rm -f "$f"; fi
done

prune() {
	# $1 directory, $2 glob, $3 how many to keep. The names carry a UTC
	# timestamp, so the glob's sorted order is the oldest first.
	keep_n="$3"
	# shellcheck disable=SC2086 # $2 is a glob
	set -- "$1"/$2
	[ -e "$1" ] || return 0
	count=$#
	for f in "$@"; do
		[ "$count" -gt "$keep_n" ] || break
		rm -f "$f"
		count=$((count - 1))
	done
}

# encrypt SRC DEST: an age file readable only with the Mac's key. The
# encrypted copies are group-readable (group lunaway-pull, from the setgid
# directory), the plaintext files private to postgres.
encrypt() {
	(
		umask 0027
		age --encrypt --recipients-file "$recipient_file" --output "$2.partial" "$1"
	)
	mv "$2.partial" "$2"
}

pg_dump --dbname=lunaway --format=custom --compress=zstd:6 --file="$primary/lunaway-$stamp.dump.partial"
# A dump that pg_restore cannot list is not a backup.
pg_restore --list "$primary/lunaway-$stamp.dump.partial" > /dev/null
mv "$primary/lunaway-$stamp.dump.partial" "$primary/lunaway-$stamp.dump"

# Roles and their memberships, without password hashes: the passwords live in
# /etc/lunaway/*.env and are set again by infra/server/postgres.sh.
pg_dumpall --globals-only --no-role-passwords --file="$primary/globals-$stamp.sql"

encrypt "$primary/lunaway-$stamp.dump" "$offsite/lunaway-$stamp.dump.age"
encrypt "$primary/globals-$stamp.sql" "$offsite/globals-$stamp.sql.age"
cp "$offsite/lunaway-$stamp.dump.age" "$mirror/lunaway-$stamp.dump.age"
cp "$offsite/globals-$stamp.sql.age" "$mirror/globals-$stamp.sql.age"
# The plaintext copies earlier versions left on the root disk.
for f in "$mirror"/lunaway-*.dump "$mirror"/globals-*.sql; do
	if [ -e "$f" ]; then rm -f "$f"; fi
done

prune "$primary" 'lunaway-*.dump' "$keep"
prune "$primary" 'globals-*.sql' "$keep"
prune "$mirror" 'lunaway-*.dump.age' "$mirror_keep"
prune "$mirror" 'globals-*.sql.age' "$mirror_keep"
prune "$offsite" 'lunaway-*.dump.age' "$keep"
prune "$offsite" 'globals-*.sql.age' "$keep"

(
	umask 0027
	echo "$stamp" > "$offsite/last-success.new"
)
mv "$offsite/last-success.new" "$offsite/last-success"
echo "dump lunaway-$stamp.dump: $(du -h "$primary/lunaway-$stamp.dump" | cut -f1), encrypted copy $(du -h "$offsite/lunaway-$stamp.dump.age" | cut -f1)"
