#!/bin/sh
# Pulls the backend's encrypted dumps and their markers into the replica on
# the ops server's volume, then drops the dumps older than
# LUNAWAY_REPLICA_DAYS; then the encrypted photos. Runs as lunaway-backup
# from lunaway-replica.service. The backend forces this key to `rrsync -ro`
# on its off-site directory, so the pull can read that directory and nothing
# else.
#
#   dumps    no --delete: the replica keeps more days than the backend
#   photos   media/ (one .age file per photo) mirrored with --delete, but a
#            file deleted on the backend is moved to media-deleted/<day>,
#            kept LUNAWAY_DELETED_DAYS (26) days, then dropped: a photo deleted
#            on the backend (moderation, an account deleted) leaves every copy
#            within 30 days, and a mistaken deletion can be undone meanwhile
set -eu
replica=/srv/data/backups/postgresql
deleted=/srv/data/backups/media-deleted
days="${LUNAWAY_REPLICA_DAYS:-14}"
hold="${LUNAWAY_DELETED_DAYS:-26}"
ssh_cmd="ssh -F /etc/lunaway-ops/ssh_config"

rsync -rt --timeout=300 --exclude=/media/ -e "$ssh_cmd" backend-replica: "$replica/"

# The names carry the dump's UTC date (lunaway-20261006T001502Z.dump.age):
# a file whose date is before the cutoff goes.
cutoff=$(date -u -d "$days days ago" +%Y%m%d)
for f in "$replica"/lunaway-*.dump.age "$replica"/globals-*.sql.age; do
	[ -e "$f" ] || continue
	day=$(basename "$f" | sed -E 's/^[a-z]+-([0-9]{8})T.*/\1/')
	case "$day" in
	[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]) ;;
	*) continue ;;
	esac
	if [ "$day" -lt "$cutoff" ]; then
		rm -f "$f"
		echo "dropped $(basename "$f")"
	fi
done
newest=$(find "$replica" -maxdepth 1 -name 'lunaway-*.dump.age' -printf '%f\n' | sort | tail -n 1)
echo "replica: $(find "$replica" -maxdepth 1 -name 'lunaway-*.dump.age' | wc -l) dumps, newest ${newest:-none}, last-success $(cat "$replica/last-success" 2>/dev/null || echo none)"

# Fixed modes rather than the backend's (setgid directories, which the
# unit's RestrictSUIDSGID refuses): the replica directory above is 2750, so
# only lunaway-pull (the Mac) and this account reach these files anyway.
today=$(date -u +%Y%m%d)
rsync -rtp --timeout=600 --chmod=D0755,F0644 --delete --backup --backup-dir="$deleted/$today" \
	-e "$ssh_cmd" backend-replica:media/ "$replica/media/"
# Each held copy is filed under the day the backend deleted its photo
# (media/deletions, kept 30 days there) and dropped 26 days after that day,
# however late this pull runs; a copy the list does not name was deleted
# more than 30 days ago and goes now. The list and the marker, which
# --backup also moves aside when they change, are not kept.
list="$replica/media/deletions"
held_cutoff=$(date -u -d "$hold days ago" +%Y%m%d)
find "$deleted" -type f ! -name '*.webp.age' -delete
find "$deleted" -type f -name '*.webp.age' | while IFS= read -r f; do
	rel=$(printf '%s' "$f" | sed -nE "s|^$deleted/[0-9]{8}/(photos/[0-9a-f]{2}/[0-9a-f]{2}/[0-9a-f]{64}\\.webp\\.age)\$|\\1|p")
	if [ -z "$rel" ]; then
		rm -f "$f"
		continue
	fi
	day=$(awk -v p="$rel" '$1 ~ /^[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]$/ && $2 == p { print $1; exit }' "$list" 2>/dev/null)
	if [ -z "$day" ] || [ "$day" -lt "$held_cutoff" ]; then
		rm -f "$f"
		echo "dropped the copy of a photo deleted ${day:-before the 30 days the list covers}"
	elif [ "$f" != "$deleted/$day/$rel" ]; then
		mkdir -p "$(dirname "$deleted/$day/$rel")"
		mv -f "$f" "$deleted/$day/$rel"
	fi
done
find "$deleted" -mindepth 1 -depth -type d -empty -delete
echo "photos: $(find "$replica/media" -type f -name '*.webp.age' | wc -l) in the replica, $(find "$deleted" -type f -name '*.webp.age' | wc -l) deleted ones held, media last-success $(cat "$replica/media/last-success" 2>/dev/null || echo none)"
