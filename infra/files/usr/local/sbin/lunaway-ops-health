#!/bin/sh
# Disk facts of the ops server as one JSON object, computed at each call:
# the forced command of the Gatus probe key on this server's own loopback
# (infra/server/ops-replica.sh writes the authorized_keys line). Gatus runs
# here and can only check what answers over the network, so it reads its own
# server's disks through SSH to 127.0.0.1, as it reads the backend's.
# Runs as lunaway-pull, reads nothing secret, writes nothing, ignores the
# command the client asked for.
#
#   data_volume   whether /srv/data (the dump replica, 14 nightly dumps) is
#                 mounted, how full it is, and its free bytes
#   root_disk     how full / is
set -u
percent() { df --output=pcent "$1" 2>/dev/null | tail -n 1 | tr -dc '0-9'; }
free_bytes() { df --output=avail -B1 "$1" 2>/dev/null | tail -n 1 | tr -dc '0-9'; }
if mountpoint -q /srv/data; then mounted=true; else mounted=false; fi
data_used="$(percent /srv/data)"
data_free="$(free_bytes /srv/data)"
root_used="$(percent /)"
printf '{"data_volume":{"mounted":%s,"used_percent":%s,"free_bytes":%s},"root_disk":{"used_percent":%s}}\n' \
	"$mounted" "${data_used:-100}" "${data_free:-0}" "${root_used:-100}"
