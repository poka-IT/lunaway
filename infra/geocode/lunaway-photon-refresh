#!/usr/bin/env bash
# Installs the newest Photon databases and switches Photon to them
# (/usr/local/sbin/lunaway-photon-refresh [europe|morocco], both by
# default; run by its monthly timer on the backend; docs/deploy.md,
# "Geocoding").
#
#   europe   GraphHopper's ready-made Europe database (about 32 GB to
#            download, 48 GB unpacked), checked against its published MD5
#   morocco  imported here from GraphHopper's Africa dump (about 600 MB,
#            MD5 checked too), Morocco alone (-country-codes ma), in about
#            three minutes
#
# Each instance has two slots, /srv/photon/<instance>/a and b, and
# /srv/photon/<instance>/current pointing at the one served. A refresh
# fills the other slot as the dump streams in (no copy of the dump is kept
# on disk: the root disk also holds the database, the routing graphs and
# the basemap), switches, restarts photon@<instance> and runs searches that
# must answer; when they do not, the previous slot serves again. Once the
# new slot answers, the previous one is removed, so the disk holds one
# Europe database outside a refresh. Nothing is done when the dump served
# is the one published.
set -euo pipefail
# shellcheck source=infra/geocode/version.sh
. /usr/local/share/lunaway/geocode/version.sh

log() { echo "lunaway-photon-refresh: $*"; }

# as_photon CMD...: CMD as the photon account. What comes from the network
# (the download, its unpacking, Photon's import) never runs as root; root
# keeps the switch, the restart and the removal of a slot.
as_photon() { setpriv --reuid=photon --regid=photon --clear-groups -- "$@"; }

# A tee that writes the MD5 of what went through to the file it is given,
# at the end, so the dump is checked without being stored. The MD5 is the
# one GraphHopper publishes beside each dump; a mismatch throws the new slot
# away before anything switches.
MD5_TEE='
import hashlib, sys
digest = hashlib.md5(usedforsecurity=False)
out = sys.stdout.buffer
for chunk in iter(lambda: sys.stdin.buffer.read(1 << 20), b""):
    digest.update(chunk)
    out.write(chunk)
out.flush()
with open(sys.argv[1], "w") as f:
    f.write(digest.hexdigest() + "\n")
'

# answers PORT QUERY:CC...: Photon on PORT is up and finds each query in
# its country.
answers() {
  local port="$1" pair q cc
  shift
  for _ in $(seq 1 60); do
    curl -fsS -o /dev/null --max-time 2 "http://127.0.0.1:$port/api?q=test&limit=1" 2>/dev/null && break
    sleep 5
  done
  for pair in "$@"; do
    q="${pair%%:*}"
    cc="${pair##*:}"
    curl -fsS --max-time 5 -G "http://127.0.0.1:$port/api" --data-urlencode "q=$q" -d limit=1 \
      | grep -q "\"countrycode\":\"$cc\"" || { log "no $cc answer for \"$q\" on port $port"; return 1; }
  done
}

# empty_slot INSTANCE SLOT: removes the slot by its literal name.
empty_slot() {
  case "$1:$2" in
    europe:a) rm -rf --one-file-system /srv/photon/europe/a ;;
    europe:b) rm -rf --one-file-system /srv/photon/europe/b ;;
    morocco:a) rm -rf --one-file-system /srv/photon/morocco/a ;;
    morocco:b) rm -rf --one-file-system /srv/photon/morocco/b ;;
    *) log "no slot $1:$2"; return 1 ;;
  esac
}

refresh() {
  local instance="$1" url port size_gb floor_gb dir current previous next remote_md5 free_gb got_md5
  case "$instance" in
    # What a new database takes when none serves yet: Europe 48 GB unpacked
    # in October 2026, Morocco 120 MB.
    europe) url="$PHOTON_DUMP_URL" port=2322 size_gb=55 ;;
    morocco) url="$PHOTON_MOROCCO_DUMP_URL" port=2323 size_gb=1 ;;
    *) log "unknown instance $instance"; return 1 ;;
  esac
  dir="/srv/photon/$instance"
  install -d -m 0750 -o photon -g photon "$dir"
  current="$(readlink "$dir/current" 2>/dev/null || true)"
  case "$current" in
    "$dir/a") next=b previous=a ;;
    "$dir/b") next=a previous=b ;;
    *) next=a previous="" ;;
  esac

  remote_md5="$(as_photon curl -fsS --max-time 60 "$url.md5" | awk '{ print $1 }')"
  [[ "$remote_md5" =~ ^[0-9a-f]{32}$ ]] || { log "$instance: no checksum published beside the dump"; return 1; }
  # Files of the slots are photon's: read as photon, so that a link planted
  # there never makes root read a file of its own choice.
  if [ -n "$current" ] && [ "$(as_photon head -c 64 "$current/SOURCE_MD5" 2>/dev/null | tr -dc '0-9a-f')" = "$remote_md5" ]; then
    log "$instance: the database served is the one published ($remote_md5)"
    return 0
  fi

  empty_slot "$instance" "$next"
  rm -f "$dir/download" "$dir/download.md5"
  # Room: the new database, about the size of the one served, plus a tenth,
  # must leave a tenth of the disk free, which the database, the routing
  # graphs and the basemap share.
  if [ -n "$current" ]; then
    size_gb="$(du -s -BG "$current" | cut -f1 | tr -dc '0-9')"
  fi
  free_gb="$(df --output=avail -BG /srv/photon | tail -n 1 | tr -dc '0-9')"
  floor_gb="$(( $(df --output=size -BG /srv/photon | tail -n 1 | tr -dc '0-9') / 10 ))"
  if [ $(( free_gb - size_gb - size_gb / 10 )) -lt "$floor_gb" ]; then
    log "$instance: $free_gb GB free, a database of about $size_gb GB would leave less than $floor_gb GB"
    return 1
  fi

  install -d -m 0750 -o photon -g photon "$dir/$next"
  log "$instance: streaming $url into $dir/$next"
  case "$instance" in
    europe)
      as_photon curl -fsS --retry 3 --retry-delay 30 "$url" \
        | as_photon python3 -c "$MD5_TEE" "$dir/download.md5" \
        | as_photon lbzip2 -n 4 -dc \
        | as_photon tar -x -C "$dir/$next" --no-same-owner --no-same-permissions
      ;;
    morocco)
      as_photon curl -fsS --retry 3 --retry-delay 30 "$url" \
        | as_photon python3 -c "$MD5_TEE" "$dir/download.md5" \
        | as_photon zstd -dc \
        | as_photon java -Xmx1g -jar /opt/photon/photon.jar import -import-file - -country-codes ma \
          -data-dir "$dir/$next" -j 2
      ;;
  esac
  got_md5="$(as_photon head -c 64 "$dir/download.md5" 2>/dev/null | tr -dc '0-9a-f')"
  rm -f "$dir/download.md5"
  [[ "$got_md5" =~ ^[0-9a-f]{32}$ ]] || got_md5=""
  if [ "$got_md5" != "$remote_md5" ]; then
    log "$instance: the download hashes to ${got_md5:-nothing readable}, GraphHopper publishes $remote_md5; new slot removed"
    empty_slot "$instance" "$next"
    return 1
  fi
  [ -d "$dir/$next/photon_data" ] || { log "$instance: no photon_data in the new database"; return 1; }
  # Written as photon too: the slot is photon's, and a link planted there
  # must not turn a write of root's elsewhere.
  echo "$remote_md5" | as_photon tee "$dir/$next/SOURCE_MD5" >/dev/null
  date -u +%Y-%m-%dT%H:%M:%SZ | as_photon tee "$dir/$next/INSTALLED_AT" >/dev/null

  ln -sfn "$dir/$next" "$dir/current.new"
  mv -T "$dir/current.new" "$dir/current"
  systemctl restart "photon@$instance"
  local checks
  case "$instance" in
    europe) checks=("unter den linden berlin:DE" "zaragoza:ES" "via del corso roma:IT") ;;
    morocco) checks=("chefchaouen:MA" "avenue mohammed v rabat:MA") ;;
  esac
  if answers "$port" "${checks[@]}"; then
    log "$instance: serving $dir/$next ($remote_md5)"
    if [ -n "$previous" ]; then
      empty_slot "$instance" "$previous"
      log "$instance: removed the previous database ($dir/$previous)"
    fi
    return 0
  fi
  if [ -n "$current" ]; then
    log "$instance: the new database does not answer, back to $current"
    ln -sfn "$current" "$dir/current.new"
    mv -T "$dir/current.new" "$dir/current"
    systemctl restart "photon@$instance"
  fi
  return 1
}

# The lock in root's runtime directory (the unit's RuntimeDirectory),
# outside what photon may write.
exec 9>"${RUNTIME_DIRECTORY:-/run/lunaway-photon-refresh}/lock"
flock -n 9 || { log "another refresh holds the lock"; exit 0; }
status=0
for instance in "${@:-morocco europe}"; do
  for one in $instance; do
    refresh "$one" || status=1
  done
done
exit "$status"
