# Lunaway's translation server (docs/deploy.md, "Translation"), on the
# geocoding server: OPUS-MT models on CTranslate2, answering the backend's
# Caddy on the private network, which forwards the API's requests
# (infra/caddy/geocoders.caddy). Installed by infra/server/translate.sh.
[Unit]
Description=Lunaway translation server (OPUS-MT on CTranslate2)
Documentation=https://github.com/poka-IT/lunaway/blob/main/docs/deploy.md
After=network-online.target
Wants=network-online.target
# Before the first models there is nothing to serve: skip the unit
# instead of failing it into its start limit.
ConditionPathExists=/srv/translate/models/fr-en/current/lunaway.json
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
ExecStart=/opt/lunaway-translate/venv/bin/python /usr/local/lib/lunaway-translate/server.py
Environment=LUNAWAY_TRANSLATE_LISTEN=10.42.0.4:2324
Environment=LUNAWAY_TRANSLATE_MODELS=/srv/translate/models
# Two texts at once, two threads each: four of the eight cores at most,
# the others left to Photon, which also has the larger CPU weight below.
Environment=LUNAWAY_TRANSLATE_WORKERS=2
Environment=LUNAWAY_TRANSLATE_THREADS=2
Environment=LUNAWAY_TRANSLATE_BEAM=4
Environment=LUNAWAY_TRANSLATE_QUEUE=8
# A second under the API's own wait (LUNAWAY_TRANSLATE_TIMEOUT_MS, 15 s): a
# text it stopped waiting for frees its worker.
Environment=LUNAWAY_TRANSLATE_DEADLINE=14
# The models' own threads read this; numpy's and OpenMP's would otherwise
# start one per core.
Environment=OMP_NUM_THREADS=2
# Each model runs its own threads, about four once it has been asked, and
# glibc gives every thread its own heap arena, which keeps what a long text
# took: without this line, long texts through the 28 pairs left 4.0 GB
# resident and 1.3 GB swapped, against 3.3 GB with two arenas for all.
Environment=MALLOC_ARENA_MAX=2
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5s
TimeoutStartSec=2min
TimeoutStopSec=20s

User=translate
Group=translate
UMask=0077

# Filesystem: the whole tree read-only, the models included; nothing is
# written anywhere.
ProtectSystem=strict
ProtectHome=yes
TemporaryFileSystem=/srv:ro
BindReadOnlyPaths=/srv/translate/models
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectProc=invisible

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateIPC=yes
KeyringMode=private

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

# Network: it listens on the private address, for the backend and for the
# checks on this host, and connects to nothing.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost 10.42.0.2/32 10.42.0.4/32
SocketBindDeny=any
SocketBindAllow=tcp:2324

# Resources: the 28 models take 3.1 GB resident after a start, 3.3 GB once
# every pair has translated long texts (measured 2026-10-09); the model
# files' pages the unit read fill the rest up to MemoryHigh, which takes
# them back first. A runaway process is stopped before it takes Photon's
# page cache.
MemoryHigh=4G
MemoryMax=4608M
CPUWeight=20
CPUQuota=400%
TasksMax=256
LimitNOFILE=4096
Nice=5

[Install]
WantedBy=multi-user.target
