# The translation server's Python packages (infra/translate/lunaway-translate.py),
# compiled into requirements.txt with their hashes for the backend
# (Debian 13, CPython 3.13, x86_64):
#   uv pip compile infra/translate/requirements.in --python-version 3.13 \
#     --python-platform x86_64-manylinux_2_28 --only-binary :all: \
#     --generate-hashes --no-header -o infra/translate/requirements.txt
