# The public domain of Lunaway. Installed in /etc/caddy/sites-available/ by
# infra/server/caddy.sh and loaded only once infra/enable-domain.sh links it
# into /etc/caddy/sites-enabled/, after the DNS records point at this host: a
# name that does not resolve here only collects failed Let's Encrypt
# validations, which are rate limited. Uses the snippets of the main Caddyfile.
#
# lunaway.net layout:
#   /          the landing site, static HTML and CSS (/srv/lunaway/site),
#              French at / and English under /en/, with /privacy, /about,
#              /legal, /fdroid/ and /account/delete as plain pages; only
#              /account/delete runs a script (its form calls the API)
#   /app/      the Flutter web build (/srv/lunaway/web), every unknown path
#              falling back to /app/index.html for the app's router
#   /fdroid/repo/  Lunaway's F-Droid repository (/srv/lunaway/fdroid), the
#              fdroid_repo snippet of the main Caddyfile
# Photos are served by the API host (api.lunaway.net/media/, see the api
# snippet of the main Caddyfile), the basemap by tiles.lunaway.net (the tiles
# snippet).
# /srv/lunaway/site and /srv/lunaway/web are symlinks switched by
# infra/deploy-web.sh.

api.lunaway.net {
	import api
}

# The basemap: tiles, TileJSON, glyphs, sprites, styles and offline packs,
# all public data (the tiles snippet sets CORS and the cache headers).
tiles.lunaway.net {
	import access_log
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Resource-Policy "cross-origin"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; sandbox"
	}
	# Alone, because a deletion defers its whole header block to write time,
	# where it would override the per-route headers of the snippet.
	header -Server
	request_body {
		max_size 16KB
	}
	vars tiles_base https://tiles.lunaway.net
	import tiles
}

lunaway.net {
	import access_log
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(self), geolocation=(self), microphone=(), payment=(), usb=(), serial=(), hid=(), bluetooth=()"
	}
	# Alone, because a deletion defers its whole header block to write time,
	# where it would override the per-route headers below.
	header -Server
	request_body {
		max_size 64KB
	}

	redir /app /app/ permanent

	# The F-Droid repository under /fdroid/repo/ (the fdroid_repo snippet of
	# the main Caddyfile). Its address, which a phone without F-Droid opens
	# in the browser, leads to the page that explains it.
	redir /fdroid/repo /fdroid/ 302
	redir /fdroid/repo/ /fdroid/ 302
	import fdroid_repo

	# The web app. The CSP allows what a Flutter web app with MapLibre needs:
	# WebAssembly compilation, blob: workers, the inline styles the engine
	# injects, the API and our tile host (tiles, glyphs, sprites, styles).
	# Build the app with --base-href /app/ --no-web-resources-cdn, or
	# CanvasKit loads from www.gstatic.com and the CSP refuses it. The
	# startup files carry their content's digest in their name
	# (app/tool/web/fingerprint.py: name.<12 hex>.js, canvaskit-<12 hex>/):
	# cached for a year, never revalidated, which also lets V8 keep their
	# compiled code. Every other name is revalidated (the ETag answers 304).
	# The two matchers exclude each other, as on the site below. Each build
	# carries a Brotli copy (name.br) of its text and WebAssembly files,
	# served to the browsers that accept it; the others get zstd or gzip.
	#
	# Only the app's own routes (/app/place/42) fall back to index.html. A
	# file it asks for by name, under assets/, fonts/, canvaskit/, icons/ or
	# with an extension, is served or answers 404: Flutter asks this origin
	# for fallback fonts and must get a 404, not HTML.
	handle_path /app/* {
		root * /srv/lunaway/web
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; child-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.lunaway.net; font-src 'self' data:; connect-src 'self' https://api.lunaway.net https://tiles.lunaway.net; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		@hashed path_regexp \.[0-9a-f]{12}\.(js|mjs|css|wasm)$|^/canvaskit-[0-9a-f]{12}/
		@not_hashed not path_regexp \.[0-9a-f]{12}\.(js|mjs|css|wasm)$|^/canvaskit-[0-9a-f]{12}/
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header @not_hashed Cache-Control "no-cache"
		@route {
			not path /assets/* /fonts/* /canvaskit/* /canvaskit-* /icons/*
			not path_regexp \.[A-Za-z0-9]+$
			not file
		}
		rewrite @route /index.html
		file_server {
			precompressed br
		}
	}

	# The landing site, in French at / and English under /en/: HTML and CSS,
	# so the CSP of its pages allows no script. The account deletion page is
	# the one exception: its form sends a GraphQL mutation to the API, so it
	# may run the site's own script files and connect to api.lunaway.net,
	# nothing else. The two matchers exclude each other because Caddy runs
	# every matching header directive, and an unmatched one would come last
	# and overwrite the other. /privacy serves privacy.html or
	# privacy/index.html. Assets whose name carries a content hash
	# (name.0123abcd.css) are cached for a year, HTML and the rest for five
	# minutes.
	handle {
		root * /srv/lunaway/site
		@delete_page path /account/delete /account/delete.html /en/account/delete /en/account/delete.html
		@other_pages not path /account/delete /account/delete.html /en/account/delete /en/account/delete.html
		header @delete_page Content-Security-Policy "default-src 'none'; script-src 'self'; connect-src https://api.lunaway.net; style-src 'self'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		header @other_pages Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		@hashed path_regexp \.[0-9a-f]{8,}\.(css|js|woff2|svg|png|jpg|jpeg|webp|avif|ico)$
		@not_hashed not path_regexp \.[0-9a-f]{8,}\.(css|js|woff2|svg|png|jpg|jpeg|webp|avif|ico)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header @not_hashed Cache-Control "public, max-age=300"
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	# A missing page or file answers with the site's own 404 page (French and
	# English in one), under the script-free CSP of the pages. Other errors
	# keep Caddy's empty answer. The error routes do not run the site's
	# header deletion, hence the second -Server.
	handle_errors 404 {
		# A file the web app asked for and does not have (a fallback font):
		# a bare 404, not the site's page. handle_path stripped /app from the
		# path, hence the original URI.
		@app expression {http.request.orig_uri.path}.startsWith("/app/")
		header @app -Server
		respond @app 404
		root * /srv/lunaway/site
		rewrite * /404.html
		encode zstd gzip
		header Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		header Cache-Control "public, max-age=300"
		header -Server
		file_server {
			status 404
		}
	}
}

www.lunaway.net {
	import access_log
	header -Server
	redir https://lunaway.net{uri} permanent
}
