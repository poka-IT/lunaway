# Caddy configuration of a Lunaway backend. infra/server/caddy.sh renders it
# to /etc/caddy/Caddyfile, replacing __SSLIP_HOST__ with the name derived from
# the server's IPv4 address (a-b-c-d.sslip.io), which serves the API, and the
# basemap under /tiles/, before and alongside the real domain. The
# lunaway.net sites live in
# lunaway.net.caddy and load only once infra/enable-domain.sh has linked them
# into /etc/caddy/sites-enabled/.
{
	# Admin API on a unix socket in /run/caddy (0750, caddy only), so no other
	# local process, the API included, can rewrite the proxy configuration.
	admin unix//run/caddy/admin.sock

	# Let's Encrypt only, matching the domain's CAA record: no fallback CA.
	acme_ca https://acme-v02.api.letsencrypt.org/directory

	servers {
		protocols h1 h2 h3
		# read_body bounds the whole request. A photo upload (10 MiB) needs
		# time on a slow mobile link, and Caddy 2.11 has no per-route read
		# timeout (request_body accepts no read_timeout, in the Caddyfile or
		# in JSON), so the server-wide bound is 3 minutes, above the API's own
		# 120 s for an upload. The other bodies stay capped at 1 MB below, and
		# headers must still arrive within 10 s.
		timeouts {
			read_header 10s
			read_body 3m
			idle 2m
		}
		max_header_size 16KB
	}

	# Caddy's own log (start, certificates, errors, and the requests for a
	# host no site serves, which it logs here rather than in the access log)
	# goes to the journal. The same masks as the access log apply, so no
	# full client address is ever written; "remote" is the field of the TLS
	# logger.
	log default {
		output stderr
		format filter {
			request>remote_ip ip_mask 16 32
			request>client_ip ip_mask 16 32
			request>remote_port delete
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>headers>X-Forwarded-For delete
			request>headers>Range delete
			request>headers>If-Range delete
			request>headers>If-Match delete
			request>headers>If-None-Match delete
			resp_headers>Set-Cookie delete
			resp_headers>Etag delete
			resp_headers>Content-Length delete
			resp_headers>Content-Range delete
			size delete
			request>uri multi_regexp {
				regexp "^/media/[^?]*" "/media/[photo]"
				regexp "/([0-9]+)/[0-9]+/[0-9]+\.mvt" "/${1}/x/y.mvt"
				regexp "/packs/[a-z0-9-]+\.pmtiles" "/packs/[pack].pmtiles"
				regexp "\?.*$" "?"
			}
			remote ip_mask 16 32
		}
	}
}

# Access log without client addresses in clear: IPv4 truncated to /16, IPv6
# to /32, no port, no credentials, no cookies, no query strings, nothing that
# names a tile (coordinates, ranges, ETags, sizes), a photo (its path) or an
# offline pack (its region).
# Kept 14 days.
(access_log) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
			roll_keep_for 336h
		}
		format filter {
			request>remote_ip ip_mask 16 32
			request>client_ip ip_mask 16 32
			request>remote_port delete
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>headers>X-Forwarded-For delete
			# A byte range of an offline pack points at a place too, and so
			# does anything that names one tile: its ETag, its exact size.
			request>headers>Range delete
			request>headers>If-Range delete
			request>headers>If-Match delete
			request>headers>If-None-Match delete
			resp_headers>Set-Cookie delete
			resp_headers>Etag delete
			resp_headers>Content-Length delete
			resp_headers>Content-Range delete
			size delete
			request>uri multi_regexp {
				# A photo's file names the place it shows: every photo path
				# is logged as one constant.
				regexp "^/media/[^?]*" "/media/[photo]"
				# A tile address is a place on the map, often where the user
				# is: the zoom stays, x and y go.
				regexp "/([0-9]+)/[0-9]+/[0-9]+\.mvt" "/${1}/x/y.mvt"
				# An offline pack names the region a traveller is heading
				# for: every pack is logged as one constant.
				regexp "/packs/[a-z0-9-]+\.pmtiles" "/packs/[pack].pmtiles"
				# Query strings never reach a log: a GraphQL GET (refused by
				# the API, but logged first) could carry a position in its
				# variables.
				regexp "\?.*$" "?"
			}
		}
	}
}

# The basemap (docs/deploy.md, "Basemap"), public OpenStreetMap data for any
# origin. Imported by the tiles.lunaway.net site at its root, and by the
# sslip.io site under /tiles/ (handle_path strips the prefix). The site sets
# the variable tiles_base to its own public base URL; the TileJSON and the
# styles are templates that receive it, so each host names itself.
#
#   /planet.json                       TileJSON, rewritten by each monthly refresh
#   /planet-<YYYYMMDD>/{z}/{x}/{y}.mvt tiles of one planet build, immutable
#   /planet/{z}/{x}/{y}.mvt            the current build, for checks and tools
#   /fonts/{fontstack}/{range}.pbf     glyphs (Noto Sans, basemaps-assets)
#   /sprites/<set>/<name>[@2x].json|png  protomaps-v4 now, ours beside it
#   /styles/<name>.json                map styles, templates like the TileJSON
#   /packs/manifest.json               the offline packs' manifest
#   /packs/<region>-<build>-<digest>.pmtiles  offline packs, whole or by range
(tiles) {
	header Access-Control-Allow-Origin "*"
	header Access-Control-Expose-Headers "ETag, Content-Length, Content-Range, Accept-Ranges"
	@preflight method OPTIONS
	handle @preflight {
		header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		header Access-Control-Allow-Headers "Range, If-Match, If-None-Match, If-Modified-Since"
		header Access-Control-Max-Age "86400"
		respond 204
	}
	@write not method GET HEAD OPTIONS
	handle @write {
		respond 405
	}

	# A stable address whose tile URLs name the current build; an hour of
	# cache bounds how long a client keeps asking for the previous build,
	# which stays served until the next refresh.
	handle /planet.json {
		root * /srv/tiles/tilejson
		header Cache-Control "public, max-age=3600"
		templates {
			mime application/json
		}
		file_server
	}

	# pmtiles serves each tile gzip-encoded, as stored in the archive, with
	# Content-Encoding: gzip; encode leaves an encoded response alone, and
	# for a client that does not accept gzip, the proxy's transport decodes
	# it (hence Vary). A tile
	# absent from the archive answers 204, a zoom beyond it 404: as permanent
	# as the tiles for a given build, so they are cached like them. Errors
	# carry no cache header. At most 64 requests reach pmtiles at once; the
	# others wait for a connection. During a restart of pmtiles, a request
	# retries for up to 3 seconds.
	@build_tile path_regexp ^/planet-[0-9]{8}/[0-9]{1,2}/[0-9]+/[0-9]+\.mvt$
	handle @build_tile {
		header Vary Accept-Encoding
		header Cache-Control "public, max-age=31536000, immutable" {
			match {
				status 200 204 404
			}
		}
		reverse_proxy 127.0.0.1:8485 {
			lb_try_duration 3s
			transport http {
				max_conns_per_host 64
				dial_timeout 2s
				response_header_timeout 10s
			}
		}
	}
	@current_tile path_regexp ^/planet/[0-9]{1,2}/[0-9]+/[0-9]+\.mvt$
	handle @current_tile {
		header Vary Accept-Encoding
		header Cache-Control "public, max-age=86400" {
			match {
				status 200 204 404
			}
		}
		reverse_proxy 127.0.0.1:8485 {
			lb_try_duration 3s
			transport http {
				max_conns_per_host 64
				dial_timeout 2s
				response_header_timeout 10s
			}
		}
	}

	# Glyphs and sprites change only with the pinned assets or a design
	# pass, without a version in their path: a week and a day of cache.
	handle /fonts/* {
		root * /srv/tiles/assets
		header Content-Type application/x-protobuf
		header Cache-Control "public, max-age=604800" {
			match {
				status 200
			}
		}
		file_server
	}
	handle /sprites/* {
		root * /srv/tiles/assets
		header Cache-Control "public, max-age=86400" {
			match {
				status 200
			}
		}
		file_server
	}
	handle /styles/* {
		root * /srv/tiles/assets
		header Cache-Control "public, max-age=3600" {
			match {
				status 200
			}
		}
		templates {
			mime application/json
		}
		file_server
	}
	# Offline packs (docs/deploy.md, "Offline packs"). The manifest names the
	# current set and changes once a month: five minutes of cache. A pack's
	# name carries its build and a digest of what made it, so it never
	# changes content: a year, immutable, whole or by byte range
	# (file_server answers Range with 206 and honours If-Range). Anything
	# else under /packs/ is a 404, never a listing.
	handle /packs/manifest.json {
		root * /srv/tiles
		header Cache-Control "public, max-age=300" {
			match {
				status 200
			}
		}
		file_server
	}
	@pack path_regexp ^/packs/[a-z0-9-]+\.pmtiles$
	handle @pack {
		root * /srv/tiles
		header Cache-Control "public, max-age=31536000, immutable" {
			match {
				status 200 206
			}
		}
		file_server
	}
	handle /packs/* {
		respond 404
	}
	handle {
		respond 404
	}
}

# Lunaway's own F-Droid repository (docs/deploy.md, "F-Droid repository"):
# the signed index, the APKs, icons and screenshots as `fdroid update`
# writes them, published by infra/fdroid/publish.sh into
# /srv/lunaway/fdroid (a symlink switched per release). Imported by
# lunaway.net, where the repository's address is
# https://lunaway.net/fdroid/repo, and by the sslip.io name, so a client can
# be tested before DNS exists. GET and HEAD only; inert content (sandbox
# CSP). The index files are revalidated on every read (ETag), so a client
# sees a new release at once; an APK's name carries its version code and
# is cached a day.
(fdroid_repo) {
	@fdroid path /fdroid/repo/* /fdroid/archive/*
	handle @fdroid {
		@fdroid_other not method GET HEAD
		header @fdroid_other Allow "GET, HEAD"
		respond @fdroid_other 405
		root * /srv/lunaway/fdroid
		uri strip_prefix /fdroid
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; sandbox"
		@fdroid_apk path *.apk
		@fdroid_not_apk not path *.apk
		header @fdroid_apk Cache-Control "public, max-age=86400"
		header @fdroid_not_apk Cache-Control "no-cache"
		file_server
	}
}

# The API: /health, /graphql, /upload and /poi/ proxied to lunaway-api,
# /media/ served from the data volume, everything else 404. The API serves
# JSON and vector tiles only, so its CSP allows nothing at all.
(api) {
	import access_log
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
	}
	# Alone, because a deletion defers its whole header block to write time,
	# where it would override the per-route headers below.
	header -Server
	# 1 MB for every request but a photo upload.
	@not_upload not path /upload
	request_body @not_upload {
		max_size 1MB
	}
	# GraphQL bodies are small (the API takes 64 KiB at most,
	# LUNAWAY_MAX_BODY_BYTES): Caddy reads one whole before it opens a
	# request to the API, so a client sending slowly (the read timeout is 3
	# minutes, for uploads) holds a Caddy goroutine, never a connection or a
	# task of the API.
	@api path /health /graphql
	handle @api {
		request_body {
			max_size 64KiB
		}
		reverse_proxy 127.0.0.1:8484 {
			request_buffers 64KiB
		}
	}
	# The map tiles of the points of interest: GET /poi/tiles.json and
	# /poi/{version}/{z}/{x}/{y}.mvt. The API sets everything a cache needs
	# (a year and immutable for a tile of the version in the URL, 5 minutes
	# for another version, 60 s for the TileJSON; ETag and 304), compresses,
	# and answers the web app's CORS preflight. Reads only: GET, HEAD and
	# OPTIONS, with a body of 1 KiB at most (the API reads none); any other
	# method 405. The access log keeps the zoom only (the .mvt mask of
	# access_log).
	handle /poi/* {
		@read method GET HEAD OPTIONS
		@other not method GET HEAD OPTIONS
		request_body {
			max_size 1KiB
		}
		header @other Allow "GET, HEAD, OPTIONS"
		respond @other 405
		reverse_proxy @read 127.0.0.1:8484
	}
	# Photo uploads: multipart/form-data, 10 MiB of image and 64 KiB of form
	# around it, what the API accepts (LUNAWAY_MAX_UPLOAD_BYTES plus its
	# framing). POST, and OPTIONS for the web app's CORS preflight, which the
	# API answers; any other method 405.
	handle /upload {
		@send method POST OPTIONS
		@other not method POST OPTIONS
		request_body {
			max_size 10304KiB
		}
		header @other Allow "POST, OPTIONS"
		respond @other 405
		reverse_proxy @send 127.0.0.1:8484
	}
	# Photos: a file present under /srv/data/media is served as is, cached
	# for a year (its name never changes content) and inert (the sandbox CSP
	# stops an SVG or HTML file from running anything). A missing file or a
	# directory falls through to the plain 404 below: no year-long cache on a
	# miss, no listing.
	@media_file {
		path /media/*
		file {
			root /srv/data
		}
	}
	handle @media_file {
		root * /srv/data
		header Cache-Control "public, max-age=31536000, immutable"
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; sandbox"
		file_server
	}
	handle {
		respond 404
	}
}

__SSLIP_HOST__ {
	# The basemap before DNS exists, and after it beside tiles.lunaway.net.
	handle_path /tiles/* {
		vars tiles_base https://__SSLIP_HOST__/tiles
		import tiles
	}
	# The F-Droid repository, for tests before DNS exists.
	import fdroid_repo
	import api
}

import /etc/caddy/sites-enabled/*.caddy
