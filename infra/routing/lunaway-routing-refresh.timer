# Daily: the weekly build starts on Sundays at 03:00 Paris time from the
# maintainer's Mac (infra/ops/mac-routing/) and publishes about four hours
# later; every morning the refresh reads the
# published build.json and stops at once when that graph already serves, so
# a run that met a half-uploaded release tries again the next day. After the
# nightly dump (00:15) and the upgrade run (01:30), before the daytime
# traffic.
[Unit]
Description=Lunaway routing: install a new graph when one is published

[Timer]
OnCalendar=*-*-* 04:30:00 UTC
RandomizedDelaySec=20min
Persistent=true

[Install]
WantedBy=timers.target
