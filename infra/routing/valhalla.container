# The Valhalla routing engine, serving the current graph to lunaway-api on
# 127.0.0.1:8002. A Podman Quadlet unit, installed to
# /etc/containers/systemd/valhalla.container (the server step is listed in
# plan/research/15-navigation-backend.md); systemd generates
# valhalla.service from it. docs/deploy.md ("Routing") has the reasoning.
#
# Serving path on Debian 13. Debian ships no Valhalla package, and building
# it on the server would bring a compiler toolchain onto the production host.
# The Valhalla project publishes an official image for amd64 and arm64
# (ghcr.io/valhalla/valhalla). It runs under Podman (Debian 13 ships 5.4)
# through this Quadlet unit, not under Docker Engine: no daemon running as
# root, and with Network=host nothing rewrites the host firewall, whereas
# Docker inserts its own rules for published ports.
#
# The graph is built weekly on a throwaway Hetzner server driven by the
# maintainer's Mac (infra/routing/europe-build.sh) and installed by lunaway-routing-refresh into /srv/routing/builds/<id>/ on
# the root disk; /srv/routing/current points at the build in service. The
# root disk is local NVMe: the tiles are memory-mapped and read at random,
# which a network volume serves slower, and they can be rebuilt.
#
# valhalla.json is the repository's infra/routing/valhalla.json, copied next
# to each graph by lunaway-routing-refresh: it reads
# /srv/routing/current/valhalla_tiles.tar, listens on 127.0.0.1:8002 and
# answers route, trace_attributes, sources_to_targets (the detours of the
# fuel search, points 60 km apart at most) and status only. Its log lines name
# the request's number, time, status and size, never a position (the body
# is not logged; checked on 2026-10-06 and on 2026-10-07 over 1 000 European
# routes). The long-request threshold of each service is set to an hour in
# valhalla.json, so a slow request is not written out whatever the
# engine's default.
#
# Install, once the first graph is in /srv/routing/current:
#   apt-get install podman
#   echo 'containers:2147483647:2147483648' >> /etc/subuid (and /etc/subgid), for UserNS=auto
#   podman pull <the Image= below>     (the unit itself reaches no network)
#   install -m 0644 infra/routing/valhalla.container /etc/containers/systemd/
#   systemctl daemon-reload && systemctl start valhalla

[Unit]
Description=Valhalla routing engine (loopback only)
RequiresMountsFor=/srv/routing
After=network-online.target
# Before the first graph there is nothing to serve.
ConditionPathExists=/srv/routing/current/valhalla.json

[Container]
# 3.9.0, pinned by the digest of its multi-architecture index (2026-10-06);
# keep equal to VALHALLA_IMAGE in infra/routing/version.sh.
Image=ghcr.io/valhalla/valhalla@sha256:511c095b8caf393dccceb8b519ec96b6f85a0166b2288ba014a8a748acc5a63c
# Four worker threads, half the backend's 8 vCPUs: PostgreSQL and the API
# keep the rest. A long European route takes 0.4 to 1.2 s of one thread
# once its tiles are in memory (plan/research/31-routage-europe.md, 3.2).
Exec=valhalla_service /srv/routing/current/valhalla.json 4
# Host network, bound to 127.0.0.1 by valhalla.json: no port publishing, no
# firewall rule, and the API reaches it on loopback.
Network=host
# Container root maps to an unprivileged range of host ids.
UserNS=auto
ReadOnly=true
Volume=/srv/routing:/srv/routing:ro
DropCapability=all
NoNewPrivileges=true
# valhalla_service ignores SIGTERM, and as PID 1 SIGINT too; podman's init
# (RunInit) did not pass SIGINT on (tested 2026-10-06). The engine keeps no
# state, so a stop is the SIGKILL, after 2 s instead of 10.
StopTimeout=2
# cgroup v2 charges the page cache of the memory-mapped tiles to the
# container. Serving Europe without a cap settled at 5.95 GB after 400
# varied routes, 4 at a time (anonymous 1.5 GB, the rest tiles); with 3 GB
# the kernel read the same tiles again and again, 15 GB for those 400
# routes, and the median rose from 0.60 to 0.84 s
# (plan/research/31-routage-europe.md, 3.3). 6 GB on the 16 GB backend
# (cx43) holds the tiles in use and still reclaims them before PostgreSQL's.
PodmanArgs=--memory=6g --pids-limit=256

[Service]
# Each stop ends in SIGKILL (137), so a plain `systemctl stop valhalla`
# leaves the unit failed; a restart, the refresh's switch, does not. 137 is
# not declared a success: a kill by the memory cap must restart the engine.
Restart=on-failure
RestartSec=5s
# The engine receives every route's positions: it reaches nothing but
# loopback (where it listens). The filter applies to the unit's cgroup,
# under which Quadlet places the container: on 2026-10-06, HTTPS from inside
# the container to 1.1.1.1 and github.com failed, and the same image outside
# the unit reached 1.1.1.1.
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
