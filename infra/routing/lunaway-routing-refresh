#!/bin/bash
# Installs the newest routing graph on the backend and switches the routing
# engine to it (docs/deploy.md, "Routing"). Run daily by
# lunaway-routing-refresh.timer as root (it restarts valhalla.service);
# installed to /usr/local/sbin/ by the server step listed in
# plan/research/15-navigation-backend.md. The graph is built weekly on a
# throwaway Hetzner server driven by the maintainer's Mac
# (infra/ops/mac-routing/), signed there and published as the assets of the
# GitHub release `routing-graph`; this script pulls it, because the
# backend's SSH is closed to anything but the admin sources.
#
#   lunaway-routing-refresh            the published graph, if it is new
#   lunaway-routing-refresh --rollback the previous graph, still on disk
#
# Layout of /srv/routing (root disk: the tiles are memory-mapped and read at
# random, and can be rebuilt):
#   incoming/<id>/          the download, kept until the next one
#   builds/<id>/            an unpacked graph: valhalla_tiles.tar,
#                           admins.sqlite, valhalla.json, build.json,
#                           prepare.json, restrictions.ndjson.gz,
#                           test-routes.txt
#   current -> builds/<id>  what valhalla.service serves (127.0.0.1:8002)
#   previous                the id served before the last switch, for
#                           --rollback
#   refused                 the id a rollback left: a published graph is
#                           installed again only when it is newer
#   candidate -> builds/<id> what valhalla-candidate.service serves for the
#                           check before a switch (127.0.0.1:8003)
#
# Order: download, check the signature and the sums, unpack, load the
# restrictions (inactive), serve the new graph on the candidate port and run
# the route tests, switch `current` by an atomic rename, restart the engine,
# run the tests again, then activate the restrictions. A failure before the
# switch changes nothing served; a failure after it switches back. Two
# graphs stay on disk: the one served and the previous.
set -euo pipefail
umask 022

ROUTING=/srv/routing
BUILDS="$ROUTING/builds"
INCOMING="$ROUTING/incoming"
RELEASE=https://github.com/poka-IT/lunaway/releases/download/routing-graph
SIGNERS=/etc/lunaway/routing-signers
CASES=/usr/local/share/lunaway/routing/test-routes.json
# The engine's configuration comes from the repository, never from the
# downloaded bundle: it only depends on this layout.
CONFIG=/usr/local/share/lunaway/routing/valhalla.json
# A signed graph older than this is refused: a replay of an old release.
MAX_AGE_DAYS=30
LUNAWAY=/opt/lunaway/current/lunaway
LIVE=http://127.0.0.1:8002
CANDIDATE=http://127.0.0.1:8003
ID_RE='^[0-9]{8}T[0-9]{4}Z-[a-z0-9]{2,16}$'
PART_RE='^graph\.tar\.gz\.part-[0-9]{2}$'
# The graph's files, the only names unpacked or removed.
GRAPH_FILES=(valhalla_tiles.tar admins.sqlite valhalla.json)
META_FILES=(build.json prepare.json restrictions.ndjson.gz test-routes.txt)
# GitHub answers a release download with a 302 to its asset host
# (release-assets.githubusercontent.com on 2026-10-06): without --location,
# curl takes the empty redirect for the file.
CURL_SAFE=(--location --proto "=https" --proto-redir "=https" --max-redirs 5 --fail --silent --show-error
  -A "Lunaway routing refresh (+https://lunaway.net)")

die() { echo "error: $*" >&2; exit 1; }
log() { echo "$*"; }

for f in "$SIGNERS" "$CASES" "$CONFIG" "$LUNAWAY"; do
  [ -e "$f" ] || die "$f is missing"
done
[ -n "${DATABASE_URL:-}" ] || die "DATABASE_URL is not set (EnvironmentFile=/etc/lunaway/ingest.env)"
mkdir -p "$BUILDS" "$INCOMING"
exec 9>"$ROUTING/.lock"
flock -n 9 || die "another refresh is running"

wait_for() {
  for _ in $(seq 1 90); do
    curl -fsS --max-time 2 "$1/status" >/dev/null 2>&1 && return 0
    sleep 2
  done
  return 1
}

remove_build() {
  local id=$1
  [[ "$id" =~ $ID_RE ]] || die "refusing to remove $id"
  local dir="$BUILDS/$id"
  for f in "${GRAPH_FILES[@]}" "${META_FILES[@]}" valhalla-candidate.json; do
    rm -f "$dir/$f"
  done
  rmdir "$dir"
}

current_id() { basename "$(readlink "$ROUTING/current" 2>/dev/null || echo none)"; }

# The graph id of a build.json as `lunaway routing load` reads it: the
# top-level "id" of the CLI's pretty-printed object (two spaces of indent),
# exactly once. A nested or repeated "id" yields nothing.
build_id() {
  local found
  found=$(sed -nE 's/^  "id": "([^"]*)",?$/\1/p' "$1")
  [ "$(printf '%s\n' "$found" | grep -c .)" = 1 ] && printf '%s\n' "$found"
}

# Removes the downloads in $INCOMING, except the one of the id given: a
# download of the same graph resumes, any other goes, so a run of failed
# downloads never holds more than one on disk.
clear_incoming() {
  local keep=${1:-} old f base
  for old in $(ls -1 "$INCOMING" | grep -E "$ID_RE"); do
    [ "$old" = "$keep" ] && continue
    for f in "$INCOMING/$old"/*; do
      base=$(basename "$f")
      case "$base" in
        SHA256SUMS | SHA256SUMS.sig | build.json | prepare.json | restrictions.ndjson.gz | test-routes.txt) rm -f "$f" ;;
        *) [[ "$base" =~ $PART_RE ]] && rm -f "$f" ;;
      esac
    done
    rmdir "$INCOMING/$old" 2>/dev/null || true
  done
}

switch_to() {
  local id=$1
  ln -sfn "builds/$id" "$ROUTING/current.new"
  mv -Tf "$ROUTING/current.new" "$ROUTING/current"
  systemctl restart valhalla.service
  wait_for "$LIVE"
}

# The speed camera zones follow the roads of the graph served: once another
# graph serves, every zone is built again (lunaway-enforcement-full.service,
# which reads OpenStreetMap's cameras first; docs/speed-cameras.md). Queued
# without waiting: the build takes minutes and this run is done. A server
# without the unit (before the pipeline step installs it) only logs it.
rebuild_zones() {
  if systemctl start --no-block lunaway-enforcement-full.service 2>/dev/null; then
    log "zones: lunaway-enforcement-full.service queued for graph $1"
  else
    log "zones: lunaway-enforcement-full.service could not be queued; build them with: lunaway-admin enforcement build --full"
  fi
}

if [ "${1:-}" = --rollback ]; then
  now=$(current_id)
  previous=$(cat "$ROUTING/previous" 2>/dev/null || true)
  [[ "$previous" =~ $ID_RE ]] && [ -d "$BUILDS/$previous" ] || die "no previous graph on disk"
  log "rolling back from $now to $previous"
  if switch_to "$previous" && "$LUNAWAY" routing test-routes --url "$LIVE" --cases "$CASES"; then
    "$LUNAWAY" routing activate "$previous"
    printf '%s\n' "$now" >"$ROUTING/previous"
    # The next daily run must not bring the refused graph back.
    printf '%s\n' "$now" >"$ROUTING/refused"
    rebuild_zones "$previous"
    exit 0
  fi
  switch_to "$now" || true
  die "the previous graph $previous failed its tests; $now serves again"
fi

# 1. What is published.
curl "${CURL_SAFE[@]}" --max-time 60 --max-filesize 65536 -o "$ROUTING/published.json" "$RELEASE/build.json"
id=$(build_id "$ROUTING/published.json" || true)
rm -f "$ROUTING/published.json"
[[ "$id" =~ $ID_RE ]] || die "the published build.json names no graph"
if [ "$(current_id)" = "$id" ]; then
  # A run that stopped between the switch and the activation leaves the
  # database on the older graph: finish it.
  active=$("$LUNAWAY" routing graphs | awk '/\(active\)/ {print $1}')
  if [ "$active" != "$id" ]; then
    log "graph $id serves but $active is active in the database: activating $id"
    "$LUNAWAY" routing activate "$id"
  fi
  log "graph $id already serves"
  exit 0
fi
refused=$(cat "$ROUTING/refused" 2>/dev/null || true)
if [[ "$refused" =~ $ID_RE ]] && [[ ! "$id" > "$refused" ]]; then
  log "graph $id is not newer than $refused, which a rollback refused"
  exit 0
fi
# Ids carry their build time: one from the future is a forged or broken
# build, which would hold back every real one after it.
tomorrow=$(date -u -d '+1 day' +%Y%m%dT%H%MZ)
[[ "$id" < "$tomorrow" ]] || die "the published graph $id claims a build time in the future"
# Ids sort by build time: never go back to an older graph this way (a
# replayed release); --rollback is the way back.
if [[ "$(current_id)" =~ $ID_RE ]] && [[ ! "$id" > "$(current_id)" ]]; then
  die "the published graph $id is not newer than $(current_id)"
fi
log "graph $id: downloading"

# 2. Download, resumed, then check the signature and every sum.
dl="$INCOMING/$id"
clear_incoming "$id"
mkdir -p "$dl"
curl "${CURL_SAFE[@]}" --max-time 120 --max-filesize 65536 -o "$dl/SHA256SUMS" "$RELEASE/SHA256SUMS"
curl "${CURL_SAFE[@]}" --max-time 120 --max-filesize 65536 -o "$dl/SHA256SUMS.sig" "$RELEASE/SHA256SUMS.sig"
ssh-keygen -Y verify -f "$SIGNERS" -I lunaway-routing -n lunaway-routing-graph \
  -s "$dl/SHA256SUMS.sig" <"$dl/SHA256SUMS" >/dev/null || die "SHA256SUMS is not signed by the build key"
names=$(awk '{print $2}' "$dl/SHA256SUMS")
# Europe is five parts, 8.3 GB in all (2026-10-06); eight parts of 2 GiB at
# most bound what a download may put on the root disk.
part_count=$(printf '%s\n' "$names" | grep -cE "$PART_RE")
[ "$part_count" -le 8 ] || die "SHA256SUMS names more than 8 parts"
# Room for the download and its unpacked graph (2.5 times the parts for
# Europe: 8.3 GB give 20.4 GB), beside the two graphs kept: a run that would
# fill the root disk stops before it starts.
need_gb=$(( part_count * 2 * 7 / 2 + 5 ))
free_gb=$(( $(df --output=avail -B1 "$ROUTING" | tail -n 1 | tr -dc '0-9') / 1000000000 ))
[ "$free_gb" -ge "$need_gb" ] || die "$free_gb GB free on $ROUTING, $need_gb GB needed for $part_count parts"
for name in $names; do
  case "$name" in
    build.json | prepare.json | test-routes.txt) cap=$((1024 * 1024)) ;;
    restrictions.ndjson.gz) cap=$((512 * 1024 * 1024)) ;;
    *)
      [[ "$name" =~ $PART_RE ]] || die "unexpected file in SHA256SUMS: $name"
      cap=$((2048 * 1024 * 1024))
      ;;
  esac
  for attempt in 1 2 3 4 5; do
    curl "${CURL_SAFE[@]}" --max-time 3600 --max-filesize "$cap" -C - -o "$dl/$name" "$RELEASE/$name" && break
    [ "$attempt" -lt 5 ] || die "cannot download $name"
    sleep 30
  done
done
(cd "$dl" && sha256sum --quiet --check SHA256SUMS) || die "a file does not match its sum"
[ "$(build_id "$dl/build.json" || true)" = "$id" ] || die "the signed build.json names another graph"
built=$(sed -n 's/.*"built_at": *"\([0-9-]*\)T.*/\1/p' "$dl/build.json" | head -1)
[ -n "$built" ] || die "build.json has no build date"
age_days=$(( ($(date -u +%s) - $(date -u -d "$built" +%s)) / 86400 ))
[ "$age_days" -le "$MAX_AGE_DAYS" ] || die "graph $id was built on $built, more than $MAX_AGE_DAYS days ago"
[ "$age_days" -ge -1 ] || die "graph $id claims to be built in the future ($built)"

# 3. Unpack.
dir="$BUILDS/$id"
[ -e "$dir" ] && remove_build "$id"
mkdir "$dir"
# The parts the signed sums name, in their order, nothing else.
parts=$(awk '{print $2}' "$dl/SHA256SUMS" | grep -E "$PART_RE" | sort)
[ -n "$parts" ] || die "SHA256SUMS names no part of the graph"
(cd "$dl" && cat $parts) | gunzip | tar -x --no-same-owner -C "$dir" -f - valhalla_tiles.tar admins.sqlite
for f in "${META_FILES[@]}"; do
  cp "$dl/$f" "$dir/$f"
done
cp "$CONFIG" "$dir/valhalla.json"

# 4. The restrictions, inactive.
"$LUNAWAY" routing load "$dir"

# 5. The new graph on the candidate port, and its route tests.
sed -e 's#tcp://127.0.0.1:8002#tcp://127.0.0.1:8003#' \
  -e 's#/srv/routing/current/#/srv/routing/candidate/#g' \
  "$dir/valhalla.json" >"$dir/valhalla-candidate.json"
ln -sfn "builds/$id" "$ROUTING/candidate.new"
mv -Tf "$ROUTING/candidate.new" "$ROUTING/candidate"
systemctl restart valhalla-candidate.service
passed=yes
wait_for "$CANDIDATE" || passed=no
if [ "$passed" = yes ]; then
  "$LUNAWAY" routing test-routes --url "$CANDIDATE" --cases "$CASES" || passed=no
fi
systemctl stop valhalla-candidate.service
if [ "$passed" != yes ]; then
  remove_build "$id"
  die "graph $id failed its route tests on the candidate port; nothing switched"
fi

# 6. Switch, test, activate; switch back on failure.
previous=$(current_id)
log "switching from $previous to $id"
if switch_to "$id" && "$LUNAWAY" routing test-routes --url "$LIVE" --cases "$CASES"; then
  "$LUNAWAY" routing activate "$id"
  [[ "$previous" =~ $ID_RE ]] && printf '%s\n' "$previous" >"$ROUTING/previous"
else
  if [[ "$previous" =~ $ID_RE ]]; then
    switch_to "$previous" || true
  fi
  remove_build "$id"
  die "graph $id failed once served; back to $previous"
fi

# 7. Two graphs on disk: this one and the previous. The download goes too.
for old in $(ls -1 "$BUILDS" | grep -E "$ID_RE" | grep -vx "$id" | grep -vx "$previous"); do
  log "removing graph $old"
  remove_build "$old"
done
clear_incoming
log "graph $id serves"
rebuild_zones "$id"
