<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later, dark theme: navy background, and a cream icon
     background behind the mark so the navy pin stays visible.
     NormalTheme still comes from values-night/styles.xml. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_icon_background</item>
    </style>
</resources>
