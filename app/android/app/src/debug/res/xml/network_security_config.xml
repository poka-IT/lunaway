<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: plain HTTP to the developer's own machine (a local API
     or a development proxy), seen from a device through adb reverse or from
     the emulator at 10.0.2.2. Release builds keep Android's default, which
     refuses cleartext everywhere. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
