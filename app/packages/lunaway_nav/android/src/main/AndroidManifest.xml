<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Guidance keeps the position coming while the screen is off or another
         app is in front: geolocator's foreground service, declared by
         geolocator_android with foregroundServiceType="location", started
         only while a route is guided, from the app in the foreground (so no
         background location permission; the Play Console asks for a
         foreground service declaration of type location). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- The service holds a partial wake lock while it runs (the guidance's
         enableWakeLock), so the fixes and the voice go on with the screen
         off; without the permission, acquiring it throws. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- From Android 13 the service's notification shows only with this
         permission, asked when the first guidance starts; refused, the
         guidance runs all the same. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <queries>
        <!-- The speech engine the instructions are spoken with. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
