# Copy to .env (gitignored) and adjust. Read by the backend and the scripts.

# Local PostGIS from backend/compose.yaml.
DATABASE_URL=postgres://lunaway:lunaway@127.0.0.1:54329/lunaway

# API listen address.
LUNAWAY_LISTEN=127.0.0.1:8484
RUST_LOG=info

# Oldest app version the API still serves (Query.config).
LUNAWAY_MIN_APP_VERSION=0.1.0
# 1 lets pages served from localhost or 127.0.0.1 call the API (web development).
LUNAWAY_DEV_CORS=0

# API limits (lunaway_api::Limits). The values below are the defaults; an
# empty, zero or unreadable value keeps the default. Costs are GraphQL
# query complexity: the app's sync page is 67 000 (France takes 16 pages),
# a 500-place viewport about 29 000, a search about 6 000, a place's photos
# and reviews about 15 000, and every request pays 1 000 to start, refused
# or not.
# Cost a client may spend at once (at least 91 000), then regains per second.
# A client is an IPv4 address or an IPv6 /64, read from X-Forwarded-For only
# when the connection comes from loopback (Caddy); an IPv6 /48 also shares a
# budget four times larger.
LUNAWAY_RATE_BURST=3000000
LUNAWAY_RATE_PER_SECOND=40000
# Total cost of the requests running at once, all clients together: what
# bounds the API's memory (a full sync page holds about 20 MB while it runs).
LUNAWAY_MAX_COST_IN_FLIGHT=400000
# Largest request body and largest response before compression, bytes.
LUNAWAY_MAX_BODY_BYTES=65536
LUNAWAY_MAX_RESPONSE_BYTES=8388608
# Requests served at once, and how long a request waits for a slot (503 after).
LUNAWAY_MAX_CONCURRENT_REQUESTS=64
LUNAWAY_QUEUE_WAIT_MS=2000
# Longest a request may run (504 after).
LUNAWAY_REQUEST_TIMEOUT_MS=20000
# Database: queries one request runs at once, pool size, wait for a pooled
# connection, server-side limit of one statement.
LUNAWAY_DB_QUERIES_PER_REQUEST=2
LUNAWAY_DB_POOL_SIZE=16
LUNAWAY_DB_ACQUIRE_TIMEOUT_MS=5000
LUNAWAY_DB_STATEMENT_TIMEOUT_MS=5000

# Raw payload cache of the importers (default: data/ at the repository root).
# LUNAWAY_DATA_DIR=/var/lib/lunaway
# Where `lunaway packs build` writes the regional packs, served under /packs/
# of LUNAWAY_PUBLIC_URL (docs/region-packs.md).
# LUNAWAY_PACKS_DIR=/srv/data/packs

# Accounts. A session lives this many days without use; each use pushes it
# back. Answered sign-in challenges remembered at once (until they expire),
# all clients together; handing a challenge out stores nothing.
LUNAWAY_SESSION_DAYS=60
LUNAWAY_MAX_CHALLENGES=1000000

# Account deletions are written to a journal outside the database (one file
# per UTC day), replayed after a restore by `lunaway accounts
# replay-deletions`; a day is kept longer than the oldest dump copy (29 days
# on the maintainer's Mac). Unset, the journal is the repository's
# gitignored data/account-deletions; `off` keeps none (a restored backup
# then brings back the accounts deleted since). The API refuses to start
# when it cannot write the directory. The CLI reads the same variable,
# with the same default, and refuses `accounts delete` when it is off.
# Idempotency keys of contributions answer for this many days.
# LUNAWAY_DELETION_JOURNAL=/srv/data/account-deletions
LUNAWAY_DELETION_JOURNAL_DAYS=45
LUNAWAY_IDEMPOTENCY_DAYS=30

# Quotas per client (an IPv4 address or IPv6 /64, in memory only) or per
# account, as <count>/<seconds>, on top of the cost budget.
LUNAWAY_QUOTA_CHALLENGE=30/60
LUNAWAY_QUOTA_SIGN_IN=10/60
LUNAWAY_QUOTA_ACCOUNT_CREATION=5/3600
LUNAWAY_QUOTA_RECOVERY=5/3600
LUNAWAY_QUOTA_RATING=200/86400
LUNAWAY_QUOTA_REVIEW=20/86400
LUNAWAY_QUOTA_PHOTO=30/86400
LUNAWAY_QUOTA_REPORT=50/86400
LUNAWAY_QUOTA_CONFIRMATION=200/86400
LUNAWAY_QUOTA_SUBMISSION=30/86400
LUNAWAY_QUOTA_LIST=2000/86400
LUNAWAY_QUOTA_ACCOUNT=100/86400
LUNAWAY_QUOTA_ENDORSEMENT=5/86400

# Trust levels: level 1 at this age and these confirmations (or a sponsor),
# level 2 at this age and these published contributions with nothing
# removed by moderation, level 3 at these active days and contributions with
# a nomination.
LUNAWAY_TL1_MIN_AGE_DAYS=3
LUNAWAY_TL1_MIN_CONFIRMATIONS=3
LUNAWAY_TL2_MIN_AGE_DAYS=14
LUNAWAY_TL2_MIN_CONTRIBUTIONS=10
LUNAWAY_TL3_MIN_ACTIVE_DAYS=60
LUNAWAY_TL3_MIN_CONTRIBUTIONS=50

# Photos: where the files go (production /srv/data/media, which Caddy serves
# under /media/), their public URL, the largest upload, and how many are
# processed at once (each decode holds up to a few hundred megabytes).
# LUNAWAY_MEDIA_DIR=/srv/data/media
LUNAWAY_MEDIA_BASE_URL=https://api.lunaway.net/media/
LUNAWAY_MAX_UPLOAD_BYTES=10485760
LUNAWAY_MEDIA_WORKERS=2

# The external community source (docs/feeds.md). The importer
# (`lunaway ingest extcom`) refuses to run without the reference of the
# signed agreement, which every row stores as its licence, and downloads
# photos only from these hosts (comma separated); both are set at deploy
# time, never in the repository. The API's photo proxy downloads a photo
# the first time a device asks for it: downloads at once, and the longest
# one, redirects included.
# LUNAWAY_EXTCOM_AGREEMENT_REF=
# LUNAWAY_EXTCOM_PHOTO_HOSTS=
LUNAWAY_EXTERNAL_PHOTO_FETCHES=2
LUNAWAY_EXTERNAL_PHOTO_TIMEOUT_MS=20000
# Downloads per UTC day, all clients together (503 past it; a photo
# already stored is still served), and per client (an IPv4 address or an
# IPv6 /64; 300 at once, then one every 288 s; 429 past it), so one client
# cannot spend the day's downloads.
LUNAWAY_EXTERNAL_PHOTO_DAILY=5000
LUNAWAY_QUOTA_EXTERNAL_PHOTO=300/86400
# Reads of the ratings and excerpts of a list's rows (Query.placeDigests)
# per client: 300 at once, then one every 12 s, a read of an area taking
# five, a count under five then waiting for them (429 past it). They carry
# the external source's rating summaries, kept out of the feed and the packs.
LUNAWAY_QUOTA_PLACE_DIGESTS=300/3600

# Routing (Query.route): the Valhalla engine, on loopback only (another host
# turns routing off), how long one answer may take, how many engine calls run
# at once across clients, and how long a route waits for one. Routes per
# client: 30 every ten minutes, recalculations included.
LUNAWAY_VALHALLA_URL=http://127.0.0.1:8002
LUNAWAY_VALHALLA_TIMEOUT_MS=8000
LUNAWAY_ROUTING_CONCURRENCY=4
LUNAWAY_ROUTING_QUEUE_WAIT_MS=1000
LUNAWAY_QUOTA_ROUTE=30/600
# Fuel along a route (Query.fuelAlongRoute): its detours are measured by the
# same engine, with the same slots; 10 searches every ten minutes per client.
LUNAWAY_QUOTA_FUEL_ROUTE=10/600

# Addresses of the map's search (Query.searchAll): the Base Adresse
# Nationale for France and Photon elsewhere, plain HTTP on loopback or HTTPS
# (production goes through Caddy, infra/caddy/geocoders.caddy); unset, no
# address is searched. In development the Géoplateforme answers directly:
# LUNAWAY_GEOCODE_BAN_URL=https://data.geopf.fr/geocodage. Photon takes a
# list, each asked at once. How long a geocoder may take before the places
# go without it, BAN requests a second for every client together (the
# Géoplateforme allows 50 per address), Photon requests at once, and the
# searches per client that ask the geocoders.
# LUNAWAY_GEOCODE_BAN_URL=
# LUNAWAY_GEOCODE_PHOTON_URL=
LUNAWAY_GEOCODE_TIMEOUT_MS=700
LUNAWAY_GEOCODE_BAN_PER_SECOND=40
LUNAWAY_GEOCODE_PHOTON_AT_ONCE=16
LUNAWAY_QUOTA_GEOCODE=300/600

# Machine translation of the reviews and descriptions (Query.translate):
# Lunaway's translation server, plain HTTP on loopback only (production goes
# through Caddy, infra/caddy/geocoders.caddy, to the geocoding server);
# unset, nothing is translated. In development, infra/translate's server run
# by hand on 127.0.0.1:2324 answers. How long one text may take, texts asked
# at once for every client together, how long one waits for a free slot,
# and the texts translated per client (a kept translation does not count).
# LUNAWAY_TRANSLATE_URL=
LUNAWAY_TRANSLATE_TIMEOUT_MS=20000
LUNAWAY_TRANSLATE_AT_ONCE=4
LUNAWAY_TRANSLATE_QUEUE_WAIT_MS=2000
LUNAWAY_QUOTA_TRANSLATE=300/600

# Speed cameras (lunaway enforcement build): the secret that places each
# camera inside its danger zone, 32 characters at least
# (`openssl rand -hex 32`), never changed once zones are served. Left empty
# here; the build refuses to run without it.
LUNAWAY_ZONE_SECRET=

# Road events (Query.roadEvents, Mutation.reportRoadEvent): reports and
# "it is over" per account, 30 a day, and per client address, 100 a day.
LUNAWAY_QUOTA_ROAD_REPORT=30/86400
LUNAWAY_QUOTA_ROAD_REPORT_CLIENT=100/86400

# Map tiles of the points of interest and of the places (GET /poi/tiles.json,
# /poi/{version}/{z}/{x}/{y}.mvt, and the same under /places/): the API's
# public URL, which the TileJSON names in its tile URLs (and Query.regions in
# the URLs of the packs), the tiles each layer keeps in memory, how many the
# database builds at once for both, the most points one tile carries, and
# whether the places' low zooms are built ahead of the clients (0 turns it
# off).
LUNAWAY_PUBLIC_URL=https://api.lunaway.net
LUNAWAY_POI_TILE_CACHE_MB=64
LUNAWAY_POI_TILE_CONCURRENCY=4
LUNAWAY_POI_TILE_MAX_FEATURES=4000
LUNAWAY_PLACE_TILE_WARM=1
